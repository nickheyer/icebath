# icebath settings, every one at its default.
# Copy a setting into config.yaml without its leading "# ", change it in the terminal UI with
# /settings, or run: icebath config set <key> <value>
# Generated from pkg/settings by go generate ./pkg/settings; edits here are overwritten.


# ============================================================
# Model: The model, how hard it thinks, and its fallback.
# ============================================================

# Model: Which model answers your prompts.
# /model changes it for one session or saves it here.
# Applies to new sessions.
# model:
#   default: ''

# Provider: The service the model is reached through.
# Applies to new sessions.
# model:
#   provider: ''

# Reasoning effort: How long the model thinks before answering.
# More effort is slower and costs more, but is often better. Models that cannot think ignore it.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# Applies from the next turn.
# agent:
#   reasoning_effort: null

# Fast mode: Pay more for priority processing so replies come back faster.
# Auto is fast for the first seconds of each turn, cold only on a session's first turn. Only some models offer it.
# One of: normal, fast, ultrafast, auto, cold.
# Applies from the next turn.
# agent:
#   service_tier: normal

# Fallback models: Models to try, in order, when the main one fails.
# Applies from the next turn.
# fallback_providers: []

# Logins per provider: Which login each provider uses and what happens when it runs out.
# Manage logins in /logins; a session can still pin its own.
# Applies to new sessions.
# logins: {}

# Endpoint address: Custom address of the model's service.
# Empty uses the provider's own address.
# Applies to new sessions.
# model:
#   base_url: ''

# Request format: Request format the endpoint speaks.
# Empty picks it from the provider.
# Applies to new sessions.
# model:
#   api_mode: ''

# Codex research access: Ask Codex for its security research access in your own sessions.
# Only your own terminal sessions send it, and only on a Codex subscription that offers it.
# Applies from the next turn.
# agent:
#   daybreak: false

# Fast mode window: How long Fast mode stays on after it switches on by itself.
# agent:
#   fast_auto_seconds: 60

# Reasoning by model: Reasoning effort for particular models, by model name.
# Models not listed use Reasoning effort.
# agent:
#   reasoning_overrides: {}

# Answer length: How wordy answers should be, for models that support it.
# One of: low, medium, high.
# Unset: the model's default.
# agent:
#   text_verbosity: null

# Approval key: API key for smart command approval.
# Empty uses your normal login.
# Kept in .env, never in config.yaml.

# Approval URL: Custom endpoint address for smart command approval.
# auxiliary:
#   approval:
#     base_url: ''

# Approval fields: Extra request fields for smart command approval.
# auxiliary:
#   approval:
#     extra_body: {}

# Approval model: Model for smart command approval.
# Empty picks one for you.
# auxiliary:
#   approval:
#     model: ''

# Approval provider: Provider for smart command approval.
# Auto picks one for you.
# auxiliary:
#   approval:
#     provider: auto

# Approval thinking: Thinking effort for smart command approval.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# auxiliary:
#   approval:
#     reasoning_effort: null

# Approval timeout: Time limit for smart command approval.
# auxiliary:
#   approval:
#     timeout: 30

# Auto review key: API key for background reviews.
# Empty uses your normal login.
# Kept in .env, never in config.yaml.

# Auto review URL: Custom endpoint address for background reviews.
# auxiliary:
#   background_review:
#     base_url: ''

# Auto review: Let the model review sessions in the background automatically.
# auxiliary:
#   background_review:
#     enabled: true

# Auto review fields: Extra request fields for background reviews.
# auxiliary:
#   background_review:
#     extra_body: {}

# Auto review model: Model for background reviews.
# Empty picks one for you.
# auxiliary:
#   background_review:
#     model: ''

# Auto review provider: Provider for background reviews.
# Auto picks one for you.
# auxiliary:
#   background_review:
#     provider: auto

# Auto review thinking: Thinking effort for background reviews.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# auxiliary:
#   background_review:
#     reasoning_effort: null

# Auto review timeout: Time limit for background reviews.
# auxiliary:
#   background_review:
#     timeout: 120

# Compression key: API key for conversation summaries.
# Empty uses your normal login.
# Kept in .env, never in config.yaml.

# Compression URL: Custom endpoint address for conversation summaries.
# auxiliary:
#   compression:
#     base_url: ''

# Compression fields: Extra request fields for conversation summaries.
# auxiliary:
#   compression:
#     extra_body: {}

# Compression model: Model for conversation summaries.
# Empty picks one for you.
# auxiliary:
#   compression:
#     model: ''

# Stall limit: Give up a summary stream that stops sending data after this long.
# Unset: built-in 60 seconds.
# auxiliary:
#   compression:
#     no_progress_timeout: null

# Compression provider: Provider for conversation summaries.
# Auto picks one for you.
# auxiliary:
#   compression:
#     provider: auto

# Compression thinking: Thinking effort for conversation summaries.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# auxiliary:
#   compression:
#     reasoning_effort: null

# Compression timeout: Time limit for conversation summaries.
# Never less than the built-in minimum.
# auxiliary:
#   compression:
#     timeout: 120

