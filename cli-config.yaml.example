# Empty uses your normal login.
# Kept in .env, never in config.yaml.

# Vision URL: Custom endpoint address for image analysis.
# auxiliary:
#   vision:
#     base_url: ''

# Download timeout: How long to wait when downloading an image or media file.
# auxiliary:
#   vision:
#     download_timeout: 30

# Vision fields: Extra request fields for image analysis.
# auxiliary:
#   vision:
#     extra_body: {}

# Vision model: Model for image analysis.
# Empty picks one for you.
# auxiliary:
#   vision:
#     model: ''

# Vision provider: Provider for image analysis.
# Auto picks one for you.
# auxiliary:
#   vision:
#     provider: auto

# Vision thinking: Thinking effort for image analysis.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# auxiliary:
#   vision:
#     reasoning_effort: null

# Vision timeout: Time limit for image analysis.
# auxiliary:
#   vision:
#     timeout: 120

# Video model: Model that watches videos for the agent.
# Unset: the image analysis model.
# Applies from the next turn.
# auxiliary:
#   video:
#     model: null

# Guardrail ID: ID of the Bedrock guardrail to apply.
# Both the ID and the version must be set for the guardrail to apply.
# bedrock:
#   guardrail:
#     guardrail_identifier: ''

# Image workers: How many images are prepared at the same time.
# Unset: one per processor core.
# Restart the background service to apply.
# auxiliary:
#   vision:
#     max_concurrency: null

# Guardrail version: Version of the Bedrock guardrail to apply.
# bedrock:
#   guardrail:
#     guardrail_version: ''

# Vision temperature: How varied image and video descriptions may be.
# Low values give steadier descriptions.
# Applies from the next turn.
# auxiliary:
#   vision:
#     temperature: 0.1

# Guardrail streaming: Whether guardrail checks block streamed replies (sync) or not.
# One of: async, sync.
# bedrock:
#   guardrail:
#     stream_processing_mode: async

# Guardrail trace: Whether Bedrock reports why a guardrail acted.
# One of: disabled, enabled, enabled_full.
# bedrock:
#   guardrail:
#     trace: disabled

# Bedrock region: AWS region used for Bedrock requests.
# Blank takes the region from the endpoint address, else us-east-1.
# bedrock:
#   region: ''

# Key rotation: How to pick between several keys of one provider.
# Older form. The provider's login rotation setting wins when set.
# credential_pool_strategies: {}

# Stay-put window: Stay on the main model if its rate limit ends within this time.
# 0 turns this off, so any rate limit switches to the fallback.
# fallback:
#   min_switch_reset_seconds: 0

# Model overrides: Per-model limits such as context size, by provider.
# model_overrides: {}

# Min coding score: Lowest coding score for automatic OpenRouter model routing.
# openrouter:
#   min_coding_score: 0.65

# Response cache: Let OpenRouter reuse identical earlier answers.
# openrouter:
#   response_cache: true

# Cache lifetime: How long OpenRouter keeps cached answers.
# openrouter:
#   response_cache_ttl: 300

# Prompt cache time: How long the provider keeps your prompt cached.
# prompt_caching:
#   cache_ttl: 5m

# Providers: Your own named model endpoints and their settings.
# providers: {}

# Vertex project: Google Cloud project used for Vertex AI requests.
# vertex:
#   project_id: ''

# Vertex region: Google Cloud region used for Vertex AI requests.
# vertex:
#   region: global

# OpenRouter routing: Which upstream providers OpenRouter may send your requests to.
# Keys such as only, ignore, order and sort, optionally under a model name.
# Applies from the next turn.
# provider_routing: {}

# Extra headers: Extra HTTP headers sent with every request to the model.
# Header names map to values. A header set here replaces the built-in one.
# Applies to new sessions.
# model:
#   default_headers: {}

# Azure sign-in: How icebath signs in to Azure Foundry.
# One of: api_key, entra_id.
# Applies to new sessions.
# model:
#   auth_mode: api_key

# Entra options: Options of the Microsoft Entra sign-in, such as the token scope.
# Applies to new sessions.
# model:
#   entra: {}

# Older endpoints: Older list form of your own model endpoints.
# Providers holds new endpoints. Entries here still work.
# Applies to new sessions.
# custom_providers: []

# Context window: How many tokens the main model can hold, when icebath guesses wrong.
# Unset uses the size the provider reports or the built-in table.
# Unset: the size icebath detects.
# Applies to new sessions.
# model:
#   context_length: null

# ============================================================
# Agent: How long the agent works and when it shortens chats.
# ============================================================

# Personality: Tone and style preset the agent speaks with.
# Applies to every session of this profile. None uses no preset.
# Applies from the next turn.
# display:
#   personality: ''

# Max turns: Stop after this many tool calls for one request.
# Unset: no limit.
# Applies to new sessions.
# agent:
#   max_turns: null

# Coding instructions: Your own rules the agent follows when it works on code.
# Applies to new sessions.
# agent:
#   coding_instructions: ''

# Shorten long chats: Summarize older messages when a chat nears the model's limit.
# Applies to new sessions.
# compression:
#   enabled: true

# Shorten at: How full the chat gets before older messages are summarized.
# A share of the model's context window: 0.5 is half full.
# Applies to new sessions.
# compression:
#   threshold: 0.5

# Saved prompt: A note /prompt keeps for you, which the agent never reads.
# custom_prompt: ''

# Bot mode rules: Tells the agent how to behave when relayed through a bot.
# Applies to new sessions.
# agent:
#   bot_mode_protocol: true

# Budget warning point: Warns the agent when this share of its turns is used.
# A number between 0 and 1, such as 0.8 for 80 percent. Other values turn the warning off.
# Unset: no warning.
# Applies to new sessions.
# agent:
#   budget_warning_ratio: null

# Coding mode: Whether the agent switches to coding guidance in code folders.
# One of: auto, focus, on, off.
# Applies to new sessions.
# agent:
#   coding_context: auto

# Retry cost limit: Spend in dollars above which empty replies are not retried.
# Must be above zero or the built-in value is used.
# Applies to new sessions.
# agent:
#   empty_response_guard:
#     cost_threshold_usd: 0.25

# Empty reply guard: Retries when the model sends back an empty reply.
# Applies to new sessions.
# agent:
#   empty_response_guard:
#     enabled: true

# Environment note: Extra text describing your machine, added to the agent's prompt.
# Applies to new sessions.
# agent:
#   environment_hint: ''

# Check environment: Lets the agent look at installed tools before its first turn.
# Applies to new sessions.
# agent:
#   environment_probe: true

# Execution guidance: Adds extra advice on acting and finishing work to the prompt.
# Auto turns it on for model families that need it.
# One of: auto, always, never.
# Applies to new sessions.
# agent:
#   execution_guidance: auto

# Continue after intent: Keeps going when the model only says what it will do.
# Auto turns it on only for Codex style models.
# One of: auto, always, never.
# Applies to new sessions.
# agent:
#   intent_ack_continuation: auto

# Verify reminders: Most times per turn the agent is told to verify its work.
# Zero turns the reminders off.
# agent:
#   max_verify_nudges: 3

# Parallel tool advice: Tells the agent to run independent tool calls together.
# Applies to new sessions.
# agent:
#   parallel_tool_call_guidance: true

# Run time limit: Longest time one run may take before the agent is told to wrap up.
# Unset: no limit.
# Applies to new sessions.
# agent:
#   run_budget_seconds: null

# Stall guards: Stops the agent when it repeats the same calls without progress.
# Applies to new sessions.
# agent:
#   stall_guards: true

# Finish tasks advice: Reminds the agent to finish a task before it stops.
# Applies to new sessions.
# agent:
#   task_completion_guidance: true

# Tool use nudge: Pushes the model to call tools instead of only describing steps.
# Auto turns it on for model families that need it.
# One of: auto, always, never.
# Applies to new sessions.
# agent:
#   tool_use_enforcement: auto

# Verify advice: Adds how-to-verify advice to the reminders sent before stopping.
# agent:
#   verify_guidance: true

# Verify before stop: Asks the agent to check its edits before it finishes.
# agent:
#   verify_on_stop: false

# Bot turn wait: How long a queued bot message waits for the running turn.
# bot_mode:
#   turn_wait_seconds: 120

# Stop on failure: Stops the turn if the summary of old messages fails.
# compression:
#   abort_on_summary_failure: false

# Require checkpoint: Refuses to compress until a checkpoint of the chat is saved.
# Not allowed with the Codex app server mode.
# compression:
#   checkpoint_required: false

# Codex compaction: Who compacts a long Codex app server conversation.
# One of: native, icebath, off.
# compression:
#   codex_app_server_auto: native

# Raise Codex trigger: Compresses later for the newest Codex models.
# compression:
#   codex_gpt55_autoraise: true

# Codex raise notice: Shows a note when the Codex compression trigger is raised.
# compression:
#   codex_gpt55_autoraise_notice: true

# Codex compact size: Size in tokens at which native Codex compaction starts.
# Only used when native Codex compaction is on. Must be above zero.
# Unset: chosen automatically.
# compression:
#   codex_responses_compact_threshold: null

# Native Codex compaction: Lets Codex compact long conversations itself.
# compression:
#   codex_responses_native: false

# Summary idle limit: Longest the summary step may stay silent before it is given up.
# Raised automatically to fit the summary model's own timeout.
# compression:
#   context_timeout_seconds: 120

# Summary time limit: Longest a whole summary step may take.
# compression:
#   context_total_ceiling_seconds: 600

# Cleanup retry pause: Wait before retrying a failed automatic cleanup of a long chat.
# compression:
#   hygiene_failure_cooldown_seconds: 300

# Cleanup message limit: Message count that forces a cleanup of a long chat.
# compression:
#   hygiene_hard_message_limit: 5000

# Cleanup hold time: Longest a new message waits while a chat is being cleaned up.
# compression:
#   hygiene_max_turn_hold_seconds: 10

# Cleanup idle limit: Longest an automatic cleanup may stay silent before it fails.
# compression:
#   hygiene_timeout_seconds: 30

# Cleanup time limit: Longest a whole automatic cleanup may take.
# compression:
#   hygiene_total_ceiling_seconds: 600

# Compact when idle: Compresses a chat after it has sat idle this long.
# Zero turns it off.
# compression:
#   idle_compact_after_seconds: 0

# Compress in place: Keeps the same session when old messages are summarised.
# compression:
#   in_place: true

# Summary attempts: How many times a failed summary is retried.
# Between 1 and 10.
# compression:
#   max_attempts: 3

# Micro compaction: Trims old tool output a little at a time instead of all at once.
# compression:
#   micro_compact: false

# Micro compact repack: Size in tokens that triggers a repack of trimmed output.
# compression:
#   micro_compact_defrag_threshold_tokens: 2000

# Micro compact pace: Trims old tool output once every this many turns.
# compression:
#   micro_compact_every_n_turns: 1

# Keep user messages: Fewest of your latest messages always kept as written.
# compression:
#   min_tail_user_messages: 1

# Per model trigger: Compression trigger share for chosen models, by model name.
# Each value is a fraction of the model's context window, such as 0.6.
# compression:
#   model_thresholds: {}

# Summarise ahead: Prepares the summary before the trigger is reached.
# compression:
#   prepare_ahead: false

# Prune minimum gain: Least tokens a trim must free to be worth doing.
# compression:
#   proactive_prune_min_reclaim_tokens: 4096

# Prune result size: Tool output shorter than this is never trimmed.
# compression:
#   proactive_prune_min_result_chars: 8000

# Early trim size: Token size at which old tool output is trimmed early.
# Zero turns early trimming off.
# compression:
#   proactive_prune_tokens: 0

# Compression notices: Shows status messages while a chat is being compressed.
# compression:
#   progress_notices: false

# Keep first messages: Number of opening messages never summarised.
# compression:
#   protect_first_n: 3

# Keep last messages: Number of latest messages never summarised.
# compression:
#   protect_last_n: 20

# Recent history mode: How recent messages are kept when compressing.
# One of: lean, legacy.
# compression:
#   tail_mode: lean

# Summary size: Share of the trigger size the summary is squeezed to.
# Held between 0.1 and 0.8.
# compression:
#   target_ratio: 0.2

# Trigger token cap: Hard cap in tokens that triggers compression.
# Unset: share of context window.
# compression:
#   threshold_tokens: null

# Context engine: Which engine manages long conversations.
# Compressor is the built-in one. Plugins can add others.
# Applies to new sessions.
# context:
#   engine: compressor

# Context file limit: Longest project instruction file text sent, in characters.
# Unset: sized to the model.
# context_file_max_chars: null

# Context file wait: Longest wait while reading a project instruction file.
# context_file_read_timeout: 5

# Subagent API key: Key used by subagents that use their own endpoint.
# Kept in .env, never in config.yaml.

# Subagent API style: Request format of the subagent endpoint.
# Leave empty to detect it from the endpoint address.
# delegation:
#   api_mode: ''

# Subagent backend: Which backend runs subagents.
# Default runs them in this app. Plugins can add others.
# Applies to new sessions.
# delegation:
#   backend: default

# Backend settings: Settings for each subagent backend, by backend name.
# delegation:
#   backends: {}

# Subagent endpoint: Own model endpoint address for subagents.
# Leave empty to use the subagent provider or the main model.
# delegation:
#   base_url: ''

# Subagent idle limit: Stops a subagent that has been inactive this long.
# Zero means no limit. Anything set is raised to at least 30 seconds.
# delegation:
#   child_timeout_seconds: 0

# Subagent compress at: Token size at which a subagent compresses its chat.
# Zero uses the normal share of the context window. Values under 16000 are ignored.
# delegation:
#   compression_threshold_tokens: 0

# Subagent fallbacks: Providers subagents try when their own fails.
# Unset: same as main agent.
# delegation:
#   fallback_providers: null

# Subagents in chats: Whether chat subagents finish within the turn or in the background.
# One of: auto, inline, background.
# delegation:
#   gateway_mode: auto

# Separate completions: Reports each background subagent on its own, not as a group.
# delegation:
#   independent_completions: false

# Subagents keep MCP: Narrowed subagents still get the parent's MCP tools.
# delegation:
#   inherit_mcp_toolsets: true

# Parallel subagents: Most subagents that run at the same time.
# Each one uses model tokens, so high values raise cost.
# delegation:
#   max_concurrent_children: 10

# Subagent turn limit: Most tool turns one subagent may take.
# delegation:
#   max_iterations: 250

# Subagent depth: How many levels deep subagents may start more subagents.
# Each level multiplies cost.
# delegation:
#   max_spawn_depth: 1

# Subagent summary size: Longest subagent report returned to the parent.
# Longer reports are trimmed and saved to disk.
# delegation:
#   max_summary_chars: 24000

# Subagent model: Model subagents use instead of the main one.
# delegation:
#   model: ''

# One-shot subagent limit: Most subagents one single-run session may start.
# Zero means no limit.
# delegation:
#   oneshot_max_children: 2

# Subagent orchestrators: Lets subagents coordinate subagents of their own.
# delegation:
#   orchestrator_enabled: true

# Subagent worktrees: Give each subagent its own git worktree off your current commit.
# Applies from the next turn.
# delegation:
#   worktree_isolation: false

# Subagent provider: Provider subagents use instead of the main one.
# delegation:
#   provider: ''

# Subagent effort: How long subagents think before answering.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the main agent's level.
# delegation:
#   reasoning_effort: null

# Subagent request fields: Extra request fields sent with subagent model calls.
# delegation:
#   request_overrides: {}

# Auto-approve subagents: Lets subagents run risky commands without asking.
# When off, risky commands from subagents are refused.
# delegation:
#   subagent_auto_approve: false

# Subagent process news: Shows background process updates started by subagents.
# delegation:
#   surface_child_process_notifications: false

# Goal turn limit: Most turns an active goal may use.
# goals:
#   max_turns: 20

# Auto split tasks: Splits new board tasks into smaller ones automatically.
# kanban:
#   auto_decompose: true

# Splits per pass: Most tasks split in one check of the board.
# kanban:
#   auto_decompose_per_tick: 3

# Auto start subtasks: Moves new subtasks forward as soon as they are made.
# kanban:
#   auto_promote_children: true

# Follow new tasks: Follows a task for you when you create it.
# kanban:
#   auto_subscribe_on_create: true

# Default assignee: Profile that takes tasks nobody was assigned.
# kanban:
#   default_assignee: ''

# Board health limits: Custom limits for board health warnings.
# Leave unset for the built-in limits.
# Unset: the built-in thresholds.
# kanban:
#   diagnostics: null

# Board in service: Starts board tasks from the background service.
# Restart the background service to apply.
# kanban:
#   dispatch_in_gateway: true

# Board check interval: How often the board looks for tasks to start.
# At least one second.
# kanban:
#   dispatch_interval_seconds: 60

# Allowed profiles: Profiles allowed to pick up board tasks.
# Unset: any profile.
# kanban:
#   dispatch_profiles: null

# Stale task timeout: Marks a running task stale after this long without progress.
# Zero turns stale detection off.
# kanban:
#   dispatch_stale_timeout_seconds: 14400

# Keep done follows: How long follows on finished tasks are kept.
# kanban:
#   done_sub_retention_days: 30

# Task failure limit: Failures after which a task stops being retried.
# kanban:
#   failure_limit: 2

# Tasks at once: Most board tasks running at the same time.
# Must be at least 1.
# Unset: sized to free memory.
# kanban:
#   max_in_progress: null

# Tasks per profile: Most running board tasks per profile.
# Unset: no limit.
# kanban:
#   max_in_progress_per_profile: null

# Starts per pass: Most tasks started in one check of the board.
# Unset: no limit.
# kanban:
#   max_spawn: null

# Board alerts: Sends board updates from the background service.
# Restart the background service to apply.
# kanban:
#   notify_in_gateway: true

# Planner profile: Profile that plans and splits board tasks.
# kanban:
#   orchestrator_profile: ''

# Recover lost tasks: Recovers running tasks whose worker has vanished.
# kanban:
#   reconcile_orphans: true

# Auto start reviews: Starts review tasks automatically.
# kanban:
#   review_dispatch: true

# Task log copies: Old task log files kept after a log rolls over.
# kanban:
#   worker_log_backup_count: 1

# Task log size: Size at which a task log rolls over.
# kanban:
#   worker_log_rotate_bytes: 2097152

# Loop run limit: Most runs one loop may make.
# Zero means no limit.
# loops:
#   max_ticks: 100

# Loop shortest gap: Shortest time allowed between loop runs.
# loops:
#   min_interval_seconds: 30

# Self-paced longest gap: Longest wait a self-paced loop may choose.
# loops:
#   self_paced_ceiling_seconds: 900

# Self-paced shortest gap: Shortest wait a self-paced loop may choose.
# loops:
#   self_paced_floor_seconds: 60

# Active mix: Mixture preset currently in use.
# moa:
#   active_preset: ''

# Default mix: Mixture preset used when none is chosen.
# moa:
#   default_preset: default

# Mixture presets: Named groups of models that answer together, with one combining model.
# moa:
#   presets:
#     default:
#       aggregator:
#         model: anthropic/claude-opus-4.8
#         provider: openrouter
#       enabled: true
#       reference_models:
#         - model: gpt-5.5
#           provider: openai-codex
#         - model: deepseek/deepseek-v4-pro
#           provider: openrouter

# Mixture privacy: Hides private details sent to the mixture's models.
# One of: , display, full.
# moa:
#   privacy_filter: ''

# Save mixture traces: Saves a record of each mixture run to disk.
# moa:
#   save_traces: false

# Trace folder: Where mixture records are saved.
# Leave empty to use a folder in your profile.
# moa:
#   trace_dir: ''

# Personalities: Custom personalities you can switch to, by name.
# personalities: {}

# Prefill messages file: JSON file of example messages added to every conversation.
# A relative path starts from your profile folder.
# prefill_messages_file: ''

# Timezone: Time zone for dates, times and schedules, such as Europe/Berlin.
# Leave empty to use this computer's time zone.
# timezone: ''

# Stop: same failure: Stops after the same failing call repeats this many times.
# tool_loop_guardrails:
#   hard_stop_after:
#     exact_failure: 5

# Stop: no progress: Stops after a read-only call repeats with no new result.
# tool_loop_guardrails:
#   hard_stop_after:
#     idempotent_no_progress: 5

# Stop: tool failures: Stops after one tool keeps failing this many times.
# tool_loop_guardrails:
#   hard_stop_after:
#     same_tool_failure: 8

# Stop looping tools: Stops a turn that is stuck in a tool loop.
# tool_loop_guardrails:
#   hard_stop_enabled: false

# Subagents per turn: Most subagents one turn may start.
# Zero means no limit.
# tool_loop_guardrails:
#   loop_caps:
#     max_subagents: 50

# Searches per turn: Most web searches one turn may make.
# Zero means no limit.
# tool_loop_guardrails:
#   loop_caps:
#     max_web_searches: 50

# Stop loops unattended: Always stops tool loops in chats and scheduled runs.
# tool_loop_guardrails:
#   non_interactive_hard_stop_enabled: true

# Warn: same failure: Warns the agent after the same failing call repeats this often.
# tool_loop_guardrails:
#   warn_after:
#     exact_failure: 2

# Warn: no progress: Warns after a read-only call repeats with no new result.
# tool_loop_guardrails:
#   warn_after:
#     idempotent_no_progress: 2

# Warn: tool failures: Warns the agent after one tool keeps failing this often.
# tool_loop_guardrails:
#   warn_after:
#     same_tool_failure: 3

# Loop warnings: Warns the agent when it seems stuck in a tool loop.
# tool_loop_guardrails:
#   warnings_enabled: true

# ============================================================
# Tools: Which tools the agent may use.
# ============================================================

# Tool groups: Which groups of tools the agent may call, per app.
# The terminal UI uses the cli entry and each chat app its own. /tools changes the current one.
# Applies to new sessions.
# platform_toolsets: {}

# Web search: Which service answers the agent's web searches.
# Automatic picks the first service with a key, else a free one.
# One of: , exa, parallel, keenable, firecrawl, tavily, perplexity, searxng, brave-free, ddgs, xai.
# web:
#   backend: ''

# Disabled toolsets: Tool groups to switch off for every chat.
# Applies on top of Tool groups.
# agent:
#   disabled_toolsets: []

# Browser service: Where web pages open: local, or a cloud browser service.
# browser:
#   cloud_provider: local

# Auto start desktop: Start a hidden desktop on its own when a tool needs a screen.
# Only applies on a Linux machine with no display and the needed packages installed.
# bot_desktop:
#   auto_start: false

# Desktop size: Screen size of the agent's own desktop, as width x height.
# bot_desktop:
#   geometry: 1440x900

# Desktop idle stop: Stop the agent's desktop after this long without use.
# Zero or less keeps it running.
# bot_desktop:
#   idle_stop_minutes: 30

# Min free memory: Refuse to start a desktop when free memory is below this.
# Zero turns the check off.
# bot_desktop:
#   min_free_memory_mb: 1536

# Desktop placement: Where the agent's desktop runs.
# One of: auto, terminal, gateway.
# bot_desktop:
#   placement: auto

# Allow private addresses: Let the browser open local and private network addresses.
# browser:
#   allow_private_urls: false

# Local for private: Use the local browser for private addresses instead of a cloud one.
# browser:
#   auto_local_for_private_urls: true

# Camofox options: Options for the Camofox browser backend.
# A block of sub-settings such as managed_persistence, cookies_dir, timeout and temperature.
# browser:
#   camofox: {}

# Browser attach address: Attach to an already running browser at this address.
# The BROWSER_CDP_URL environment variable and a live /browser connect both win over this.
# browser:
#   cdp_url: ''

# Extra browser flags: Extra command line flags added to every Chromium launch.
# browser:
#   chromium_args: []

# Browser start timeout: How long to wait for the browser to start and answer.
# Never less than 5 seconds.
# browser:
#   command_timeout: 30

# Page dialogs: How the browser handles alert, confirm and prompt pop-ups.
# One of: must_respond, auto_dismiss, auto_accept.
# browser:
#   dialog_policy: must_respond

# Dialog wait: How long a pop-up waits for an answer before it is dealt with.
# Zero or less uses the default.
# browser:
#   dialog_timeout_s: 300

# Browser engine: Which local browser engine the tools drive.
# One of: auto, lightpanda.
# browser:
#   engine: auto

# Browser program: Use this browser program instead of the bundled one.
# browser:
#   executable_path: ''

# Show browser window: Show the browser window instead of running it hidden.
# browser:
#   headed: false

# Browser idle close: Close an unused browser session after this long.
# Never less than 30 seconds. Falls back to the BROWSER_INACTIVITY_TIMEOUT environment variable only when this is unset.
# browser:
#   inactivity_timeout: 120

# Close real browser: Close your own browser by itself when the agent needs its profile.
# Only matters when using your real browser profile is allowed.
# browser:
#   real_profile_autoclose: false

# Real profile name: Folder name of the browser profile to borrow, such as Profile 2.
# Empty uses the profile you used last. A name that does not exist stops the borrow.
# browser:
#   real_profile_pin: ''

# Use real profile: Allow the agent to use a copy of your own browser profile and logins.
# browser:
#   use_real_profile: false

# Browser profile folder: Keep one browser profile in this folder for every session.
# A relative path is placed under the Icebath home folder.
# browser:
#   user_data_dir: ''

# Kernel idle close: Close an idle code session after this long.
# Never less than 1 second.
# code_execution:
#   kernel_idle_timeout: 1800

# Max code sessions: How many code sessions can stay open at once.
# code_execution:
#   max_session_kernels: 4

# Code run folder: Where scripts run: your working folder or a scratch one.
# One of: project, strict.
# code_execution:
#   mode: project

# Allow unsigned driver: Accept a driver app that lacks the expected publisher signature.
# Only for locally built drivers on macOS.
# computer_use:
#   allow_unsigned_driver: false

# Auto start driver: Start the computer-use driver on its own when first needed.
# computer_use:
#   autostart: false

# Max screen elements: Most on-screen items listed per accessibility snapshot.
# Zero means no limit.
# computer_use:
#   ax_max_elements: 200

# Computer use backend: Which computer-use provider controls the screen.
# Names a built-in or plugin provider. Unknown names stop the tool with a list of the available ones.
# computer_use:
#   backend: cua

# Capability file: Path to a file limiting what the driver may do.
# Used only outside the standard permission mode.
# computer_use:
#   capability_manifest: ''

# Follow-up capture: What each action sends back after it runs.
# One of: som, vision, ax.
# computer_use:
#   capture_after_mode: som

# Driver telemetry: Let the computer-use driver send usage data.
# computer_use:
#   cua_telemetry: false

# Max screenshot edge: Longest side of a screenshot sent to the model, in pixels.
# Zero or less turns the cap off.
# computer_use:
#   max_image_dimension: 1456

# Native Wayland: Use Wayland directly instead of the X11 compatibility layer.
# computer_use:
#   native_wayland: false

# Hide overlay: Turn the on-screen cursor overlay off.
# Unset: decided automatically.
# computer_use:
#   no_overlay: null

# Computer use access: How much of the screen the agent may control.
# Any value other than bounded is treated as standard.
# One of: standard, bounded.
# computer_use:
#   permission_mode: standard

# Archive after: Move a skill to the archive after this many idle days.
# Counted in days, at least 1.
# curator:
#   archive_after_days: 30

# Delete archive after: Delete archived skills older than this many days.
# Zero keeps archived skills forever.
# curator:
#   archive_ttl_days: 0

# Back up first: Save a snapshot of your skills before each curator run.
# curator:
#   backup:
#     enabled: true

# Snapshots kept: How many skill snapshots to keep.
# At least 1.
# curator:
#   backup:
#     keep: 2

# Merge skills: Let the curator merge related skills with a model pass.
# Off means each run only archives idle skills.
# curator:
#   consolidate: false

# Skill curator: Automatically tidy up unused skills in the background.
# curator:
#   enabled: true

# Curator interval: How long between automatic curator runs.
# At least 1 hour.
# curator:
#   interval_hours: 168

# Curator idle wait: How long you must be idle before an automatic run starts.
# curator:
#   min_idle_hours: 2

# Prune built-in skills: Let the curator archive unused built-in skills too.
# curator:
#   prune_builtins: false

# Stale after: Mark a skill stale after this many idle days.
# Counted in days, at least 1.
# curator:
#   stale_after_days: 14

# File read limit: Most characters returned from one file read.
# Longer files are cut at a whole line.
# file_read_max_chars: 100000

# Shell hooks: Commands to run on agent events, grouped by event name.
# Each event holds a list of hook definitions. Unknown event names are ignored with a warning.
# hooks: {}

# MCP connect limit: How many MCP servers connect at the same time during discovery.
# Zero means no limit.
# mcp:
#   discovery_concurrency: 4

# MCP startup wait: How long a new turn waits for MCP servers to be found.
# Zero or less uses the default.
# mcp_discovery_timeout: 1.5

# MCP one-shot wait: How long a one-shot query waits for MCP servers to be found.
# Zero or less uses the default.
# mcp_single_query_discovery_timeout: 15

# Auto update plugins: Install plugin updates without asking.
# plugins:
#   auto_apply: false

# Plugin update check: How often to check plugins for updates.
# Zero turns the check off.
# plugins:
#   auto_update_check_hours: 24

# Plugin download limit: Longest a plugin download may take.
# Between 1 second and 1 hour.
# plugins:
#   clone_timeout_seconds: 300

# Plugin hook limit: Longest a plugin hook may take before it is cut off.
# Capped at 10 minutes.
# plugins:
#   hook_callback_timeout: 30

# Plugin launcher: Command placed before the plugin host process, such as a sandbox.
# plugins:
#   host:
#     launcher: []

# Plugin load limit: Longest a single plugin may take to load.
# Zero loads plugins inline with no limit. Capped at 10 minutes.
# plugins:
#   load_timeout_seconds: 10

# Quick commands: Your own slash commands, each running a shell command or alias.
# A mapping of command name to its definition.
# quick_commands: {}

# Preloaded skills: Skills loaded into every new session.
# skills:
#   auto_load: []

# Skill settings: Values the skills you installed ask for, by name.
# skills:
#   config: {}

# New skill folder: Folder where new skills are created.
# Empty uses the normal skills folder.
# skills:
#   create_dir: ''

# Disabled skills: Skills the agent cannot use.
# skills:
#   disabled: []

# Extra skill folders: More folders to look for skills in.
# skills:
#   external_dirs: []

# Scan agent skills: Security-scan skills the agent writes and block dangerous ones.
# skills:
#   guard_agent_created: false

# Skill shell snippets: Run shell snippets embedded in skill text.
# Never applied to skills from the community hub.
# skills:
#   inline_shell: false

# Snippet time limit: Longest an embedded shell snippet may run.
# skills:
#   inline_shell_timeout: 10

# Skill change log: Keep a log of every skill change by you, the agent or the curator.
# skills:
#   ledger: true

# Change log size: Size at which the skill change log is trimmed.
# skills:
#   ledger_max_bytes: 5242880

# Per-app disabled: Skills turned off for a single app, by app name.
# A mapping of app name to a list of skill names.
# skills:
#   platform_disabled: {}

# Project skills: Find skills inside the current project folder.
# Project skills load only when the project is trusted.
# skills:
#   project_discovery: true

# Skill variables: Fill in placeholders such as the skill folder in skill text.
# skills:
#   template_vars: true

# Install safety check: Show a quick safety scan of a skill when you install it.
# skills:
#   tier1_advisory: true

# Trusted projects: Project folders whose own skills may be loaded.
# skills:
#   trusted_project_dirs: []

# Approve skill writes: Ask before the agent saves or changes a skill.
# skills:
#   write_approval: false

# Tool output size: Most bytes of a tool result kept before it is cut.
# tool_output:
#   max_bytes: 50000

# Tool line length: Most characters kept per line of a tool result.
# tool_output:
#   max_line_length: 2000

# Tool output lines: Most lines of a tool result kept before it is cut.
# tool_output:
#   max_lines: 2000

# Deferred tools: Tools hidden until the agent searches for them, to save context.
# An empty list keeps every tool loaded up front.
# tools:
#   tool_search:
#     defer:
#       - computer_use
#       - session_search
#       - image_generate
#       - todo_list
#       - process_manage
#       - cronjob_manage
#       - browser_vault
#       - desktop_project

# Tool search: Whether rarely used tools are found by search instead of listed.
# One of: auto, on, off.
# tools:
#   tool_search:
#     enabled: auto

# Tool listing: Whether hidden tools are summarized in the prompt.
# One of: auto, on, off.
# tools:
#   tool_search:
#     listing: auto

# Listing size: Most tokens spent summarizing hidden tools.
# Between 200 and 60000.
# tools:
#   tool_search:
#     listing_max_tokens: 4000

# Max search results: Most tools one search may return.
# tools:
#   tool_search:
#     max_search_limit: 25

# Default search results: How many tools a search returns when none is asked for.
# Never above the maximum.
# tools:
#   tool_search:
#     search_default_limit: 5

# Listing context share: Share of the context window the tool summary may use.
# tools:
#   tool_search:
#     threshold_pct: 5.0

# Toolsets: Only used to turn on the Kanban tools when listed.
# Tool groups are normally chosen per platform, not here.
# toolsets:
#   - icebath-cli

# Web cache: Reuse recent web search and page results.
# web:
#   cache_enabled: true

# Uncached sites: Sites whose pages are always fetched fresh.
# Matches a site and its subdomains.
# web:
#   cache_exempt_hosts: []

# Web cache time: How long a cached web result is reused.
# Between 1 minute and 1 day.
# web:
#   cache_ttl_minutes: 20

# Page reader provider: Provider used to read web pages.
# Empty follows the main web provider.
# web:
#   extract_backend: ''

# Page text limit: Most characters kept from one web page.
# Between 2000 and 500000.
# web:
#   extract_char_limit: 15000

# Free web providers: Use free providers when no web search key is set.
# web:
#   keyless_fallback: true

# Free provider retry: Retry with a free provider when the chosen one fails.
# Needs free web providers to be on.
# web:
#   keyless_rescue: true

# Provider plan: Per provider: use its free plan, a paid key, or decide automatically.
# web:
#   provider_tier: {}

# Web search provider: Provider used for web search.
# Empty follows the main web provider.
# web:
#   search_backend: ''

# X search model: Model that runs X searches.
# x_search:
#   model: grok-4.5

# X search effort: How hard the model thinks while searching X.
# One of: low, medium, high, xhigh.
# Unset: the model's default.
# x_search:
#   reasoning_effort: null

# X search retries: How many times a failed X search is retried.
# x_search:
#   retries: 2

# X search timeout: Longest to wait for an X search.
# Never less than 30 seconds.
# x_search:
#   timeout_seconds: 180

# MCP servers: Tool servers the agent connects to, by name.
# Applies to new sessions.
# mcp_servers: {}

# Offered toolsets: Built-in toolsets each app has seen; new ones turn on.
# known_builtin_toolsets: {}

# Offered plugin tools: Plugin toolsets each app has seen; new ones turn on.
# known_plugin_toolsets: {}

# ============================================================
# Terminal: Where the agent's shell commands run.
# ============================================================

# Where commands run: The machine or sandbox where the agent's shell commands run.
# One of: local, docker, ssh, modal, daytona, vercel_sandbox.
# Applies to new sessions.
# terminal:
#   backend: local

# Working folder: Folder the agent's shell commands start in.
# terminal:
#   cwd: .

# Container image: Image the Docker sandbox starts from.
# Applies to new sessions.
# terminal:
#   docker_image: localhost/icebath-sandbox:desktop

# Auto-prune snapshots: Delete old file snapshots automatically at startup.
# checkpoints:
#   auto_prune: true

# File checkpoints: Save file snapshots so edits can be rewound.
# Applies to new sessions.
# checkpoints:
#   enabled: false

# Max file size: Largest single file a snapshot will include.
# Applies to new sessions.
# checkpoints:
#   max_file_size_mb: 10

# Snapshots kept: How many snapshots are kept per project.
# Applies to new sessions.
# checkpoints:
#   max_snapshots: 20

# Snapshot disk limit: Total disk space snapshots may use before pruning.
# Applies to new sessions.
# checkpoints:
#   max_total_size_mb: 500

# Prune interval: Fewest hours between automatic snapshot cleanups.
# checkpoints:
#   min_interval_hours: 24

# Snapshot retention: Days an old snapshot is kept before cleanup removes it.
# checkpoints:
#   retention_days: 7

# Allow key fallback: Use keys from the environment if the secret store is off.
# Only matters when the credential source is Bitwarden.
# proxy:
#   allow_env_fallback: false

# Auto-install proxy: Download the egress proxy program when it is missing.
# proxy:
#   auto_install: true

# Proxy key source: Where the egress proxy gets the real API keys it injects.
# One of: env, bitwarden.
# proxy:
#   credential_source: env

# Egress proxy: Route sandbox network traffic through the key-hiding proxy.
# Run the egress setup command first. Applies to Docker sandboxes.
# Applies to new sessions.
# proxy:
#   enabled: false

# Require proxy: Refuse to start a Docker sandbox if the proxy is not ready.
# When off, the sandbox starts without the proxy and warns.
# Applies to new sessions.
# proxy:
#   enforce_on_docker: true

# Extra allowed hosts: Extra sites the egress proxy lets sandboxes reach.
# Written into the proxy when egress setup runs.
# proxy:
#   extra_allowed_hosts: []

# Proxy port: Local port the egress proxy listens on.
# Written into the proxy when egress setup runs.
# proxy:
#   tunnel_port: 9090

# Blocked networks: Network ranges the egress proxy refuses to connect to.
# Leave unset for the built-in private network list. An empty list blocks nothing.
# Unset: built-in private ranges.
# proxy:
#   upstream_deny_cidrs: null

# Load shell profile: Load your usual shell startup files before running commands.
# Ignored when a shell init file list is set.
# terminal:
#   auto_source_bashrc: true

# Client variables: Extra variable names copied from the connecting terminal.
# Names only. Secrets are filtered out.
# Applies to new sessions.
# terminal:
#   client_env_passthrough: []

# Sandbox CPUs: CPU cores given to a container or cloud sandbox.
# Applies to new sessions.
# terminal:
#   container_cpu: 1.0

# Sandbox disk: Disk space given to a container or cloud sandbox.
# Applies to new sessions.
# terminal:
#   container_disk: 51200

# Sandbox memory: Memory given to a container or cloud sandbox.
# Applies to new sessions.
# terminal:
#   container_memory: 5120

# Keep sandbox files: Keep a sandbox's files between sessions.
# Applies to new sessions.
# terminal:
#   container_persistent: true

# Credential files: Files under the config folder copied into remote sandboxes.
# Paths are relative to the icebath home folder.
# Applies to new sessions.
# terminal:
#   credential_files: []

# Stop grace period: Wait before force-killing a background process that was asked to stop.
# Zero kills it immediately.
# terminal:
#   daemon_term_grace_seconds: 2

# Daytona image: Image Daytona sandboxes start from.
# Applies to new sessions.
# terminal:
#   daytona_image: localhost/icebath-sandbox:desktop

# Backend failure mode: What happens when the place commands run cannot be reached.
# One of: warn, fail.
# Applies to new sessions.
# terminal:
#   degraded_mode: warn

# Docker variables: Variables set inside Docker sandboxes, as name and value.
# Applies to new sessions.
# terminal:
#   docker_env: {}

# Docker extra flags: Extra flags added to the Docker run command.
# Applies to new sessions.
# terminal:
#   docker_extra_args: []

# Docker forwarded variables: Host variables passed into Docker sandboxes.
# Names only. The values come from your environment.
# Applies to new sessions.
# terminal:
#   docker_forward_env: []

# Mount working folder: Mount your current folder into the Docker sandbox.
# Applies to new sessions.
# terminal:
#   docker_mount_cwd_to_workspace: false

# Docker network: Let Docker sandboxes reach the network.
# Applies to new sessions.
# terminal:
#   docker_network: true

# Clean stray containers: Remove leftover Docker sandboxes from earlier runs.
# Unset: on.
# Applies to new sessions.
# terminal:
#   docker_orphan_reaper: null

# Reuse Docker sandbox: Keep a Docker sandbox alive so later runs can reuse it.
# Unset: on.
# Applies to new sessions.
# terminal:
#   docker_persist_across_processes: null

# Run as me: Run Docker commands as your own user, not root.
# Applies to new sessions.
# terminal:
#   docker_run_as_host_user: false

# Shared sandbox name: Name that lets sessions share one Docker sandbox.
# Empty means each session gets its own.
# Applies to new sessions.
# terminal:
#   docker_shared_container_key: ''

# Docker shared memory: Shared memory size for Docker sandboxes, such as 1g.
# Applies to new sessions.
# terminal:
#   docker_shm_size: 1g

# Snap Docker mode: Work around Docker installed as a snap package.
# Applies to new sessions.
# terminal:
#   docker_snap_compat: false

# Docker volumes: Folders mounted into Docker sandboxes, as host:container.
# Applies to new sessions.
# terminal:
#   docker_volumes: []

# Passthrough env names: Extra variable names commands may see from your environment.
# Provider keys are refused here.
# terminal:
#   env_passthrough: []

# Home folder mode: Which home folder commands see.
# One of: auto, profile, real.
# Applies to new sessions.
# terminal:
#   home_mode: auto

# Modal image: Image Modal sandboxes start from.
# Applies to new sessions.
# terminal:
#   modal_image: localhost/icebath-sandbox:desktop

# One-shot wait limit: Longest wait for a one-shot background command to finish.
# terminal:
#   oneshot_completion_wait_seconds: 600

# Persistent SSH shell: Keep one shell open between remote commands over SSH.
# Other backends have their own persistence settings.
# Applies to new sessions.
# terminal:
#   persistent_shell: true

# Notify on finish: Tell the agent when a waited-on background process ends.
# terminal:
#   process_wait_auto_notify: true

# Sandbox folder: Host folder where sandbox files are stored.
# Unset uses the sandboxes folder in the icebath home.
# Unset: the sandboxes folder in the icebath home.
# Applies to new sessions.
# terminal:
#   sandbox_dir: null

# Shell init files: Files sourced before commands run, instead of the usual ones.
# Empty falls back to the profile and bashrc files.
# terminal:
#   shell_init_files: []

# Sync-back size cap: Largest archive copied back from a remote sandbox.
# terminal:
#   sync_back_max_bytes: 2147483648

# Temp folder: Folder commands use for temporary files.
# Empty uses the normal system temp folder.
# Applies to new sessions.
# terminal:
#   temp_dir: ''

# Command timeout: Longest a foreground command may run before it is stopped.
# Applies to new sessions.
# terminal:
#   timeout: 180

# Vercel image: Image Vercel sandboxes start from.
# Applies to new sessions.
# terminal:
#   vercel_image: vercel/sandbox/universal:latest

# Vercel runtime: Language runtime for Vercel sandboxes.
# Empty uses the image setting instead.
# Applies to new sessions.
# terminal:
#   vercel_runtime: ''

# Sandbox idle limit: Idle time after which an unused sandbox is shut down.
# Applies to new sessions.
# terminal:
#   lifetime_seconds: 300

# Archive dirty trees: Save a patch of unsaved work before removing a worktree.
# worktrees:
#   archive_dirty: true

# SSH host: Machine the agent's commands run on when they run over SSH.
# Applies to new sessions.
# terminal:
#   ssh_host: ''

# Archive file limit: Largest file included in a worktree archive.
# worktrees:
#   archive_max_file_mb: 50

# SSH user: Account to log in as over SSH.
# Applies to new sessions.
# terminal:
#   ssh_user: ''

# Archive retention: Days a removed worktree's archive is kept.
# worktrees:
#   archive_retention_days: 30

# SSH port: Port to connect to over SSH.
# Applies to new sessions.
# terminal:
#   ssh_port: 22

# Install cache retention: Days unused dependency install data is kept.
# Zero or less turns cleanup off.
# worktrees:
#   install_state_retention_days: 14

# SSH key file: Private key file used to log in over SSH.
# Empty uses your SSH agent and default keys.
# Applies to new sessions.
# terminal:
#   ssh_key: ''

# Worktree disk limit: Total disk space worktrees may use before cleanup.
# Zero means no limit.
# worktrees:
#   max_total_gb: 0

# Apptainer image: Image the Apptainer sandbox starts from.
# Unset: the default sandbox image.
# Applies to new sessions.
# terminal:
#   singularity_image: null

# Persistent local shell: Keep one shell open between commands run on this machine.
# Off starts a fresh shell for every command.
# Applies to new sessions.
# terminal:
#   local_persistent: true

# Own work tree: Start each terminal session in its own git work tree.
# Applies to new sessions.
# worktree: false

# Fetch before branching: Fetch the upstream branch before making a new work tree.
# Off branches from your local HEAD.
# Applies to new sessions.
# worktree_sync: true

# ============================================================
# Safety: What the agent asks first and what it keeps private.
# ============================================================

# Approvals: Whether the agent asks before running risky commands.
# /yolo skips asking for one session without changing this.
# One of: manual, smart, off.
# approvals:
#   mode: smart

# Allowed commands: Commands you chose to always allow, which run without asking.
# command_allowlist: []

# Confirm destructive: Ask before slash commands that delete or reset things.
# approvals:
#   destructive_slash_confirm: true

# Hide personal info: Hide who wrote a chat app message and where from the model.
# Applies from the next turn.
# privacy:
#   redact_pii: false

# Hide secrets: Mask API keys and tokens in replies, session files and logs.
# Restart the background service to apply.
# security:
#   redact_secrets: true

# Scheduled job approvals: How Approvals treat risky commands in scheduled jobs.
# Approve runs risky commands with nobody watching.
# One of: deny, approve.
# approvals:
#   cron_mode: deny

# Denial limit: Stop a session after this many Approvals denials in a row.
# Zero or less turns the limit off.
# approvals:
#   denial_breaker_threshold: 3

# Always-deny patterns: Command patterns Approvals always block, even in yolo mode.
# Matched as globs against the command text.
# approvals:
#   deny: []

# Discord prompt wait: How long Discord approval buttons wait for an answer.
# approvals:
#   discord_prompt_timeout: 300

# Confirm tool reload: Ask before reconnecting tool servers from a chat command.
# approvals:
#   mcp_reload_confirm: true

# One-shot approvals: How Approvals treat risky commands in one-shot runs (-q).
# Approve runs risky commands with nobody watching.
# One of: deny, approve.
# approvals:
#   single_query_mode: deny

# Smart approval rules: Extra rules the approval reviewer model follows.
# Free text added to the reviewer's instructions.
# approvals:
#   smart_policy: ''

# Approval wait: How long an approval prompt waits before it is denied.
# approvals:
#   timeout: 300

# Unattended approvals: How Approvals treat risky commands on chat platforms.
# Approve runs risky commands with nobody watching.
# One of: deny, approve.
# approvals:
#   unattended_mode: deny

# Adopt other logins: Reuse sign-ins already saved by other command-line tools.
# auth:
#   adopt_external_logins: true

# Codex login style: How the Codex sign-in is done.
# One of: device_code, browser.
# auth:
#   codex_login_flow: device_code

# Auto-accept hooks: Approve shell hooks without asking first.
# Hooks run commands on your machine, so only enable this for trusted configs.
# hooks_auto_accept: false

# Bitwarden token variable: Environment variable holding the Bitwarden access token.
# secrets:
#   bitwarden:
#     access_token_env: BWS_ACCESS_TOKEN

# Auto-install Bitwarden: Download the Bitwarden command-line tool when missing.
# secrets:
#   bitwarden:
#     auto_install: true

# Bitwarden cache time: How long fetched Bitwarden secrets are reused.
# Zero fetches them every time.
# secrets:
#   bitwarden:
#     cache_ttl_seconds: 300

# Bitwarden secrets: Load secrets from Bitwarden Secrets Manager at startup.
# secrets:
#   bitwarden:
#     enabled: false

# Offline Bitwarden cache: Keep an encrypted copy to use when Bitwarden is unreachable.
# secrets:
#   bitwarden:
#     encrypted_cache:
#       enabled: false

# Offline cache age: Oldest offline Bitwarden copy that may still be used.
# Zero means no age limit.
# secrets:
#   bitwarden:
#     encrypted_cache:
#       max_stale_seconds: 0

# Bitwarden wins: Bitwarden values replace matching local environment values.
# secrets:
#   bitwarden:
#     override_existing: true

# Bitwarden project: Bitwarden project to load secrets from.
# Empty loads everything the token can see.
# secrets:
#   bitwarden:
#     project_id: ''

# Bitwarden server: Address of your own Bitwarden server.
# Empty uses the Bitwarden cloud.
# secrets:
#   bitwarden:
#     server_url: ''

# 1Password account: 1Password account to use.
# Empty uses the default account.
# secrets:
#   onepassword:
#     account: ''

# 1Password tool path: Full path of the 1Password command-line tool.
# Empty looks it up on the search path.
# secrets:
#   onepassword:
#     binary_path: ''

# 1Password cache time: How long fetched 1Password secrets are reused.
# Zero fetches them every time.
# secrets:
#   onepassword:
#     cache_ttl_seconds: 300

# 1Password secrets: Load secrets from 1Password at startup.
# secrets:
#   onepassword:
#     enabled: false

# 1Password references: Variables to load, as name and op:// reference.
# secrets:
#   onepassword:
#     env: {}

# 1Password wins: 1Password values replace matching local environment values.
# secrets:
#   onepassword:
#     override_existing: true

# 1Password token variable: Environment variable holding the service account token.
# secrets:
#   onepassword:
#     service_account_token_env: OP_SERVICE_ACCOUNT_TOKEN

# Keep local values: Variable names no secret store may overwrite.
# secrets:
#   preserve_existing: []

# Profile name aliases: Also expose secrets under profile-prefixed variable names.
# secrets:
#   profile_alias: true

# Dismissed advisories: Security notices you have already acknowledged.
# security:
#   acked_advisories: []

# Allow training plans: Let non-interactive runs go ahead on data-training plans.
# Otherwise such runs stop and ask for acknowledgement.
# security:
#   allow_data_training_tiers_noninteractive: false

# Allow on-demand installs: Let tools install missing add-ons the first time they are used.
# security:
#   allow_lazy_installs: true

# Allow private URLs: Let web tools open local and private network addresses.
# security:
#   allow_private_urls: false

# Approval channel: Which channel delivers Approvals prompts.
# Built-in uses the normal prompt. A plugin name sends prompts through that plugin.
# security:
#   approval:
#     transport: builtin

# Approval fallback: What happens when the chosen approval channel fails.
# One of: deny, builtin.
# security:
#   approval:
#     transport_fallback: deny

# Fake IP ranges: Address ranges a local DNS proxy hands out for real sites.
# Web tools check the real address instead of these.
# security:
#   fake_ip_ranges: []

# Extra protected files: Extra file names the agent needs approval to edit.
# security:
#   protected_instruction_extra_patterns: []

# Protect instruction files: Ask before the agent edits project instruction files.
# security:
#   protected_instruction_files: true

# Blocked sites: Websites web tools refuse to open.
# security:
#   website_blocklist:
#     domains: []

# Website blocklist: Block web tools from the sites on the list.
# security:
#   website_blocklist:
#     enabled: false

# Blocklist files: Files of blocked sites to load as well.
# security:
#   website_blocklist:
#     shared_files: []

# Bitwarden tool path: Full path of the Bitwarden command-line tool.
# Empty looks it up on the search path.
# vault:
#   bitwarden:
#     binary_path: ''

# Bitwarden logins: Offer Bitwarden as a source of website logins.
# vault:
#   bitwarden:
#     enabled: true

# Vault key storage: Where a new vault's encryption key is kept.
# One of: file, keychain.
# vault:
#   key_storage: file

# 1Password account: 1Password account to use for website logins.
# Empty uses the default account.
# vault:
#   onepassword:
#     account: ''

# 1Password tool path: Full path of the 1Password command-line tool.
# Empty looks it up on the search path.
# vault:
#   onepassword:
#     binary_path: ''

# 1Password logins: Offer 1Password as a source of website logins.
# vault:
#   onepassword:
#     enabled: true

# 1Password token variable: Environment variable holding the service account token.
# vault:
#   onepassword:
#     service_account_token_env: OP_SERVICE_ACCOUNT_TOKEN

# ============================================================
# Voice: Talking to the agent and hearing its replies.
# ============================================================

# Voice input: Talk instead of typing: a key records you and sends the words.
# voice:
#   input_enabled: false

# Speak replies: Read the assistant's replies aloud, or send voice messages in chats.
# The terminal UI speaks while voice input is on. A chat keeps its own choice once /voice is used there.
# voice:
#   speak_replies: false

# Record key: Extra key that starts and stops a recording (default: none).
# The leader key followed by R always records; a binding in your keys file wins over this.
# voice:
#   record_key: ''

# Send or draft: Send what you said at once, or leave it in the input box to edit.
# One of: direct, draft.
# voice:
#   submit_mode: direct

# Speech voice: Which service speaks for icebath.
# Each service's voice is under advanced.
# One of: edge, elevenlabs, openai, minimax, xai, mistral, gemini, deepinfra, neutts, kittentts, piper.
# tts:
#   provider: edge

# Speech recognition: Turn your recordings and voice messages into text.
# stt:
#   enabled: true

# Recognition service: Which service turns your speech into text.
# One of: local, local_command, groq, openai, mistral, xai, elevenlabs, deepinfra.
# stt:
#   provider: local

# Wake word: Say the wake phrase to start recording without the keyboard.
# wake_word:
#   enabled: false

# Show transcripts: Post the text of your voice messages back into the chat.
# Restart the background service to apply.
# stt:
#   echo_transcripts: true

# Tag helper key: Key for the model that adds tone tags to speech text.
# Kept in .env, never in config.yaml.

# Tag helper endpoint: Custom endpoint for the model that adds tone tags to speech.
# auxiliary:
#   tts_audio_tags:
#     base_url: ''

# Tag helper fields: Extra request fields sent to the tone tagging model.
# auxiliary:
#   tts_audio_tags:
#     extra_body: {}

# Tag helper model: Model that adds tone tags to speech text.
# Empty picks one for you.
# auxiliary:
#   tts_audio_tags:
#     model: ''

# Tag helper provider: Service for the model that adds tone tags.
# Auto picks one for you.
# auxiliary:
#   tts_audio_tags:
#     provider: auto

# Tag helper effort: How long the tone tagging model thinks.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# auxiliary:
#   tts_audio_tags:
#     reasoning_effort: null

# Tag helper timeout: How long to wait for the tone tagging model before giving up.
# auxiliary:
#   tts_audio_tags:
#     timeout: 30

# Voice chat key: Key for the model that answers in voice conversations.
# Kept in .env, never in config.yaml.

# Voice chat endpoint: Custom endpoint for the model that answers in voice conversations.
# auxiliary:
#   voice_chat:
#     base_url: ''

# Voice chat fields: Extra request fields sent to the voice conversation model.
# auxiliary:
#   voice_chat:
#     extra_body: {}

# Voice chat model: Model that answers in voice conversations.
# Empty picks one for you.
# auxiliary:
#   voice_chat:
#     model: ''

# Voice chat provider: Service for the voice conversation model.
# Auto picks one for you.
# auxiliary:
#   voice_chat:
#     provider: auto

# Voice chat effort: How long the voice conversation model thinks (default: off).
# Less thinking answers sooner.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# auxiliary:
#   voice_chat:
#     reasoning_effort: none

# Voice chat timeout: How long to wait for a voice reply before giving up.
# auxiliary:
#   voice_chat:
#     timeout: 120

# Trim padding: Quiet audio kept around speech when trimming before upload.
# stt:
#   cloud_trim_keep_ms: 300

# Trim silence: Cut silence from recordings before sending them to a cloud service.
# stt:
#   cloud_trim_silence: true

# Trim threshold: Loudness below which audio counts as silence when trimming.
# stt:
#   cloud_trim_threshold_db: -40

# DeepInfra model: Speech recognition model used with DeepInfra.
# Empty uses the service's default.
# stt:
#   deepinfra:
#     model: ''

# ElevenLabs endpoint: Custom endpoint for ElevenLabs speech recognition.
# Unset: the provider endpoint.
# stt:
#   elevenlabs:
#     base_url: null

# Label speakers: Have ElevenLabs mark who is speaking in transcripts.
# stt:
#   elevenlabs:
#     diarize: false

# ElevenLabs language: Language code for ElevenLabs transcripts.
# Empty detects it.
# stt:
#   elevenlabs:
#     language_code: ''

# ElevenLabs model: Speech recognition model used with ElevenLabs.
# stt:
#   elevenlabs:
#     model_id: scribe_v2

# Tag sounds: Mark non-speech sounds such as laughter in ElevenLabs transcripts.
# stt:
#   elevenlabs:
#     tag_audio_events: false

# Groq language: Language hint for Groq transcripts.
# Empty detects it.
# stt:
#   groq:
#     language: ''

# Groq model: Speech recognition model used with Groq.
# stt:
#   groq:
#     model: whisper-large-v3-turbo

# Recognition language: Language of your speech, as a language code such as en.
# Used when the chosen service has no language of its own.
# stt:
#   language: en

# Local prompt: Text that primes the on-device recognizer, such as names or jargon.
# stt:
#   local:
#     initial_prompt: ''

# Local language: Language hint for on-device recognition.
# Empty detects it.
# stt:
#   local:
#     language: ''

# Confidence cutoff: Average confidence below which on-device text is retried.
# stt:
#   local:
#     logprob_threshold: -1.0

# Local model: Size of the on-device speech recognition model.
# stt:
#   local:
#     model: base

# No-speech cutoff: Chance of no speech above which a clip is treated as silence.
# stt:
#   local:
#     no_speech_prob_threshold: 0.6

# Unload when idle: Free the on-device recognizer after this long unused.
# Zero keeps it loaded.
# stt:
#   local:
#     unload_after_idle_seconds: 0

# Skip silence: Detect speech and skip silent parts before on-device recognition.
# stt:
#   local:
#     vad: true

# Silence length: How long a pause must last to count as a break in speech.
# stt:
#   local:
#     vad_min_silence_ms: 500

# Mistral language: Language hint for Mistral transcripts.
# Empty detects it.
# stt:
#   mistral:
#     language: ''

# Mistral model: Speech recognition model used with Mistral.
# stt:
#   mistral:
#     model: voxtral-mini-latest

# OpenAI recognition key: Key for OpenAI speech recognition.
# Kept in .env, never in config.yaml.

# OpenAI recognition endpoint: Custom endpoint for OpenAI-compatible speech recognition.
# Unset: the provider endpoint.
# stt:
#   openai:
#     base_url: null

# OpenAI language: Language hint for OpenAI transcripts.
# Empty detects it.
# stt:
#   openai:
#     language: ''

# Retry attempts: How many times to retry a failed recognition request.
# stt:
#   openai:
#     max_retries: 1

# OpenAI model: Speech recognition model used with OpenAI.
# stt:
#   openai:
#     model: whisper-1

# OpenAI live model: Model used for live transcription with OpenAI.
# stt:
#   openai:
#     streaming_model: gpt-live-transcribe

# OpenAI timeout: How long to wait for OpenAI to transcribe before giving up.
# stt:
#   openai:
#     timeout: 60

# Recognition prompt: Text that primes cloud recognition, such as names or jargon.
# Unset: no static prompt.
# stt:
#   prompt: null

# Live transcription: Show words as you speak when the chosen service supports it.
# stt:
#   streaming: false

# xAI recognition endpoint: Custom endpoint for xAI speech recognition.
# Unset: the provider endpoint.
# stt:
#   xai:
#     base_url: null

# xAI language: Language hint for xAI transcripts.
# Empty detects it.
# stt:
#   xai:
#     language: ''

# xAI model: Speech recognition model used with xAI.
# Empty uses the service's default.
# stt:
#   xai:
#     model: ''

# DeepInfra model: Speech model used with DeepInfra.
# Empty uses the service's default.
# tts:
#   deepinfra:
#     model: ''

# DeepInfra speed: How fast DeepInfra speaks.
# 1 is normal.
# Unset: the general speech speed.
# tts:
#   deepinfra:
#     speed: null

# DeepInfra voice: Voice used with DeepInfra.
# tts:
#   deepinfra:
#     voice: default

# Edge speed: How fast the Edge voice speaks.
# 1 is normal.
# Unset: the general speech speed.
# tts:
#   edge:
#     speed: null

# Edge voice: Voice used with Edge speech.
# tts:
#   edge:
#     voice: en-US-AriaNeural

# ElevenLabs endpoint: Custom endpoint for ElevenLabs speech.
# Unset: the provider endpoint.
# tts:
#   elevenlabs:
#     base_url: null

# ElevenLabs model: Speech model used with ElevenLabs.
# tts:
#   elevenlabs:
#     model_id: eleven_multilingual_v2

# ElevenLabs live model: Speech model for ElevenLabs when speaking as text arrives.
# Unset: the ElevenLabs model.
# tts:
#   elevenlabs:
#     streaming_model_id: null

# ElevenLabs voice: Voice used with ElevenLabs, by its ID.
# tts:
#   elevenlabs:
#     voice_id: pNInz6obpgDQGcFmaJgB

# Gemini tone tags: Add tone cues to text before Gemini speaks it.
# tts:
#   gemini:
#     audio_tags: false

# Gemini endpoint: Custom endpoint for Gemini speech.
# Unset: the provider endpoint.
# tts:
#   gemini:
#     base_url: null

# Gemini model: Speech model used with Gemini.
# tts:
#   gemini:
#     model: gemini-2.5-flash-preview-tts

# Gemini persona file: Path to a text file describing how Gemini should sound.
# tts:
#   gemini:
#     persona_prompt_file: ''

# Gemini voice: Voice used with Gemini.
# tts:
#   gemini:
#     voice: Kore

# Keep voice loaded: How long a local voice stays loaded after use.
# Zero unloads it at once.
# tts:
#   keep_warm_seconds: 60

# Clean text: Tidy text before KittenTTS speaks it.
# tts:
#   kittentts:
#     clean_text: true

# KittenTTS model: On-device speech model used with KittenTTS.
# tts:
#   kittentts:
#     model: KittenML/kitten-tts-nano-0.8-int8

# KittenTTS speed: How fast KittenTTS speaks.
# 1 is normal.
# tts:
#   kittentts:
#     speed: 1.0

# KittenTTS voice: Voice used with KittenTTS.
# tts:
#   kittentts:
#     voice: Jasper

# MiniMax endpoint: Custom endpoint for MiniMax speech.
# Unset: the endpoint of the region.
# tts:
#   minimax:
#     base_url: null

# MiniMax bitrate: Audio quality of MiniMax speech, in bits per second.
# tts:
#   minimax:
#     bitrate: 128000

# MiniMax emotion: Emotion MiniMax puts in its speech, such as neutral or happy.
# tts:
#   minimax:
#     emotion: neutral

# MiniMax group ID: Account group ID sent to MiniMax.
# Unset: none.
# tts:
#   minimax:
#     group_id: null

# MiniMax model: Speech model used with MiniMax.
# tts:
#   minimax:
#     model: speech-02-hd

# MiniMax pitch: Raise or lower the MiniMax voice pitch.
# tts:
#   minimax:
#     pitch: 0

# MiniMax region: Which MiniMax service region to use.
# One of: global, cn.
# Unset: global, or China when only a China key is set.
# tts:
#   minimax:
#     region: null

# MiniMax sample rate: Audio sample rate for MiniMax speech, in Hz.
# tts:
#   minimax:
#     sample_rate: 32000

# MiniMax speed: How fast MiniMax speaks.
# 1 is normal.
# tts:
#   minimax:
#     speed: 1.0

# MiniMax voice: Voice used with MiniMax, by its ID.
# tts:
#   minimax:
#     voice_id: English_expressive_narrator

# MiniMax volume: How loud MiniMax speaks.
# tts:
#   minimax:
#     vol: 1.0

# Mistral endpoint: Custom endpoint for Mistral speech.
# Unset: the provider endpoint.
# tts:
#   mistral:
#     base_url: null

# Mistral model: Speech model used with Mistral.
# tts:
#   mistral:
#     model: voxtral-mini-tts-2603

# Mistral voice: Voice used with Mistral, by its ID.
# tts:
#   mistral:
#     voice_id: c69964a6-ab8b-4f8a-9465-ec0925096ec8

# Speech model: Speech model for plugin voice services.
# Unset: the plugin provider's model.
# tts:
#   model: null

# NeuTTS device: Where NeuTTS runs, such as cpu or cuda.
# tts:
#   neutts:
#     device: cpu

# NeuTTS model: On-device speech model used with NeuTTS.
# tts:
#   neutts:
#     model: neuphonic/neutts-air-q4-gguf

# NeuTTS sample audio: Path to a sample recording of the voice to copy.
# tts:
#   neutts:
#     ref_audio: ''

# NeuTTS sample text: Path to the transcript of the sample recording.
# tts:
#   neutts:
#     ref_text: ''

# OpenAI speech key: Key for OpenAI speech.
# Kept in .env, never in config.yaml.

# OpenAI speech endpoint: Custom endpoint for OpenAI-compatible speech.
# Unset: the provider endpoint.
# tts:
#   openai:
#     base_url: null

# Voice consent: Consent statement sent when using a custom cloned voice.
# tts:
#   openai:
#     consent_attestation: ''

# OpenAI language: Language hint sent with OpenAI-compatible speech.
# Unset: no language hint.
# tts:
#   openai:
#     language: null

# OpenAI model: Speech model used with OpenAI.
# tts:
#   openai:
#     model: gpt-4o-mini-tts

# Live sample rate: Audio sample rate when OpenAI speech plays as it arrives, in Hz.
# tts:
#   openai:
#     pcm_sample_rate: 24000

# OpenAI speed: How fast OpenAI speaks.
# 1 is normal, from 0.25 to 4.
# Unset: the general speech speed.
# tts:
#   openai:
#     speed: null

# OpenAI voice: Voice used with OpenAI.
# tts:
#   openai:
#     voice: alloy

# Live latency boost: Trade quality for faster start when speech plays as it arrives.
# Used by xAI speech when its own setting is absent.
# Unset: no boost.
# tts:
#   optimize_streaming_latency: null

# Output format: Audio format produced by command-based voices.
# Unset: the default format of command providers.
# tts:
#   output_format: null

# Piper pace: Stretches or shortens Piper speech.
# Higher is slower.
# Unset: the voice's own value.
# tts:
#   piper:
#     length_scale: null

# Piper variation: How much natural variation Piper adds to the voice.
# Unset: the voice's own value.
# tts:
#   piper:
#     noise_scale: null

# Piper timing variation: How much Piper varies the timing of words.
# Unset: the voice's own value.
# tts:
#   piper:
#     noise_w_scale: null

# Even out volume: Level out loudness in Piper speech.
# tts:
#   piper:
#     normalize_audio: true

# Piper speaker: Which speaker to use in a multi-speaker Piper voice.
# tts:
#   piper:
#     speaker_id: 0

# Piper on GPU: Run Piper on the graphics card instead of the processor.
# tts:
#   piper:
#     use_cuda: false

# Piper voice: Voice used with Piper.
# tts:
#   piper:
#     voice: en_US-lessac-medium

# Piper voices folder: Folder where Piper voices are stored and downloaded.
# Unset: the voices folder in the icebath home.
# tts:
#   piper:
#     voices_dir: null

# Piper volume: How loud Piper speaks.
# 1 is unchanged.
# tts:
#   piper:
#     volume: 1.0

# Speech speed: How fast voices speak.
# 1 is normal. Services with their own speed setting use that instead.
# Unset: normal speed.
# tts:
#   speed: null

# Live chunk size: Smallest piece of text spoken at once while streaming speech.
# tts:
#   streaming:
#     min_len: 20

# Live speech service: Service for speech that plays as the text arrives.
# Unset: the Speech voice service.
# tts:
#   streaming:
#     provider: null

# Speech voice name: Voice for plugin voice services.
# Unset: the plugin provider's voice.
# tts:
#   voice: null

# xAI auto tags: Add expressive speech tags to text before xAI speaks it.
# tts:
#   xai:
#     auto_speech_tags: false

# xAI speech endpoint: Custom endpoint for xAI speech.
# Unset: the provider endpoint.
# tts:
#   xai:
#     base_url: null

# xAI bitrate: Audio quality of xAI speech, in bits per second.
# tts:
#   xai:
#     bit_rate: 128000

# xAI language: Language xAI speaks in, as a language code.
# tts:
#   xai:
#     language: en

# xAI latency boost: Trade quality for faster start in xAI speech.
# Zero turns it off.
# tts:
#   xai:
#     optimize_streaming_latency: 0

# xAI sample rate: Audio sample rate for xAI speech, in Hz.
# tts:
#   xai:
#     sample_rate: 24000

# xAI speed: How fast xAI speaks.
# 1 is normal.
# tts:
#   xai:
#     speed: 1.0

# xAI live endpoint: Custom endpoint for xAI speech that plays as it arrives.
# Unset: the provider streaming endpoint.
# tts:
#   xai:
#     streaming_url: null

# xAI text cleanup: Have xAI spell out numbers and symbols before speaking.
# Unset: the service default.
# tts:
#   xai:
#     text_normalization: null

# xAI voice: Voice used with xAI.
# tts:
#   xai:
#     voice_id: eve

# Interrupt by talking: Stop spoken replies when you start talking over them.
# voice:
#   barge_in: true

# Interrupt grace: Time after a reply starts before talking can interrupt it.
# voice:
#   barge_in_grace_seconds: 0.5

# Interrupt sensitivity: How much louder than the room you must be to interrupt.
# Zero turns the loudness check off.
# voice:
#   barge_in_threshold_multiplier: 3.0

# Recording beep: Play a beep when recording starts and stops.
# voice:
#   beep_enabled: true

# Beep volume: How loud the recording beep is, from 0 to 1.
# voice:
#   beep_volume: 0.3

# Longest recording: Voice input stops listening after this long.
# voice:
#   max_recording_seconds: 120

# Silence length: Seconds of quiet before recording stops on its own.
# voice:
#   silence_duration: 3.0

# Silence level: Loudness below which audio counts as quiet.
# Raise it in noisy rooms.
# voice:
#   silence_threshold: 200

# Stop phrases: Spoken words that end voice conversation mode.
# voice:
#   stop_phrases:
#     - stop

# Thinking sound: Play soft blips while waiting for a reply.
# voice:
#   thinking_sound: true

# Confirmation frames: Checks in a row that must hear the Wake word before it triggers.
# wake_word:
#   confirmation_frames: 3

# Wake microphone: Microphone to listen on, by number or name.
# Unset: the default microphone.
# wake_word:
#   input_device: null

# Wake model file: Path to the model file used for the Wake word.
# wake_word:
#   openwakeword:
#     model: ''

# Wake phrase: Phrase that wakes the assistant.
# wake_word:
#   phrase: hey icebath

# Porcupine keyword: Built-in keyword Porcupine listens for.
# wake_word:
#   porcupine:
#     keyword: jarvis

# Route by profile: Each profile can have its own Wake word and answers to it.
# wake_word:
#   profile_routing: true

# Wake engine: Engine that listens for the Wake word.
# Auto picks one for you.
# wake_word:
#   provider: auto

# Wake sensitivity: How easily the Wake word triggers, from 0 to 1.
# Higher catches more but triggers by mistake more often.
# wake_word:
#   sensitivity: 0.6

# Sherpa model folder: Folder holding the Sherpa Wake word model.
# wake_word:
#   sherpa:
#     model_dir: ''

# Start fresh session: Begin a new session each time the Wake word is heard.
# wake_word:
#   start_new_session: true

# Wake listens in: Which screen runs the Wake word listener.
# One of: auto, cli, tui, gui.
# wake_word:
#   surface: auto

# ============================================================
# Images & media: Pictures and video the agent can make or look at.
# ============================================================

# Image generation: Which service draws pictures when the agent makes an image.
# One of: , fal, openai, openai-codex, xai, openrouter, deepinfra, krea, meta-ai.
# image_gen:
#   provider: ''

# Image model: Model the image service draws with.
# Empty uses the service's default.
# image_gen:
#   model: ''

# Image input: How pictures you attach reach the model.
# One of: auto, native, text.
# Applies from the next turn.
# agent:
#   image_input_mode: auto

# Show images inline: Draw pictures inside the transcript instead of as links.
# One of: auto, kitty, unicode, off.
# display:
#   inline_images: auto

# OpenRouter model: Model OpenRouter draws with.
# Empty uses Image model, else OpenRouter's own pick.
# image_gen:
#   openrouter:
#     model: ''

# OpenRouter aspect ratio: Exact aspect ratio to ask OpenRouter for, such as 16:9.
# Unset: picked from the request.
# image_gen:
#   openrouter:
#     aspect_ratio: null

# OpenRouter endpoint: Which OpenRouter endpoint image requests go to.
# One of: images, chat.
# Unset: picked per model.
# image_gen:
#   openrouter:
#     surface: null

# OpenRouter time limit: Give up on an OpenRouter image request after this long.
# Unset: 5 minutes.
# image_gen:
#   openrouter:
#     timeout: null

# Attachment storage: Where files you attach to a prompt are saved.
# One of: icebath-home, workspace.
# attachments:
#   storage: icebath-home

# Image size budget: Size images are shrunk to when kept in chat history.
# vision:
#   embed_target_bytes: 262144

# Looks per image: Most times the same image may be analyzed in one chat.
# Zero means no limit.
# Unset: no limit.
# vision:
#   max_calls_per_image: null

# Replayed images: How many earlier images are shown to the model again.
# Zero stops earlier images from being sent again.
# vision:
#   replay_recent_images: 3

# Video generation: Plugin that makes videos when the agent asks for one.
# Unset: the first available provider.
# video_gen:
#   provider: null

# ============================================================
# Appearance: How the terminal UI looks.
# ============================================================

# Theme: Light, dark, or match the terminal.
# One of: auto, light, dark.
# display:
#   tui_theme: auto

# Skin: The colour palette and symbols drawn on top of the theme.
# display:
#   skin: default

# Language: Language of menus, notices and help.
# display:
#   language: en

# Compact: Less spacing so more of the transcript fits.
# display:
#   tui_compact: false

# Timestamps: Show the time beside each message.
# display:
#   timestamps: false

# Mouse: Which mouse actions the terminal UI takes over.
# Off leaves the mouse to the terminal, so you can select text the usual way.
# One of: all, buttons, wheel, off.
# display:
#   mouse_tracking: all

# Busy indicator: Symbols of the spinner shown while the agent works.
# One of: unicode, emoji, ascii.
# display:
#   tui_status_indicator: unicode

# Pet: Show a small animated companion that reacts to the agent's work.
# display:
#   pet:
#     enabled: false

# Classic CLI layout: Glyph layout or boxed transcript in the classic command line.
# One of: modern, classic.
# display:
#   cli_layout: modern

# Pet drawing mode: How the pet is drawn in your terminal.
# One of: auto, kitty, iterm, sixel, unicode, off.
# display:
#   pet:
#     render_mode: auto

# Pet size: How large the pet is drawn.
# Values are kept between 0.1 and 3.
# display:
#   pet:
#     scale: 0.33

# Which pet: Which installed pet is shown.
# Empty shows none.
# display:
#   pet:
#     slug: ''

# Text pet width: Width of the pet in text blocks, in terminal columns.
# Zero works the width out from the pet size.
# display:
#   pet:
#     unicode_cols: 0

# Status phrases: Your own wording for the short progress messages in chat apps.
# display:
#   status_phrases: {}

# Time format: How message times are written in the classic command line.
# Uses strftime codes. Times only show when timestamps are turned on.
# display:
#   timestamp_format: '%H:%M'

# Agents view hint: Show a hint about the agents view in the terminal UI.
# display:
#   tui_agents_nudge: true

# Native terminal mode: Let your terminal handle mouse selection and scrolling.
# Turns off mouse tracking in the terminal UI. The native flag on the command line does the same.
# display:
#   tui_native: false

# Paste collapse size: Pasted text longer than this is folded into a short placeholder.
# paste_collapse_char_threshold: 2000

# Paste collapse lines: Pasted text with more lines than this is folded into a placeholder.
# paste_collapse_threshold: 5

# ============================================================
# While it works: What you see and what Enter does while it works.
# ============================================================

# Detail level: How much of the agent's tool work and thinking you see.
# Sets tool progress and how far each part of the transcript is opened. Change single parts under advanced.
# One of: minimal, normal, detailed, everything, custom.
# display:
#   detail_level: normal

# Show thinking: Show the model's thinking in the transcript.
# Chat apps hide thinking unless their own display settings turn it on.
# display:
#   show_reasoning: true

# Enter while busy: What Enter does while the agent is still working.
# One of: queue, steer, interrupt.
# display:
#   busy_input_mode: queue

# Status bar: Where the line with model, context use and cost sits.
# One of: top, bottom, off.
# display:
#   tui_statusbar: top

# Status bar fields: Which facts the status bar shows.
# Empty shows them all. Fields: model, context, context_pct, context_detail, cost, cwd, duration, latency, tps, cache_hit, compressions, bg_tasks, bg_subagents, battery, voice.
# display:
#   status_bar:
#     fields: []

# Battery: Show the laptop battery level in the status bar.
# display:
#   battery: false

# Bell when done: Ring the terminal bell when the agent finishes a turn.
# display:
#   bell_on_complete: false

# Bell on question: Ring the terminal bell when the agent needs your answer.
# display:
#   bell_on_prompt: false

# Tool progress: Which tool calls get a line in the transcript while the agent works.
# One of: off, new, all, verbose, log.
# display:
#   tool_progress: all

# Fold parts: Whether thinking, tools and subagents start hidden, folded or open.
# One of: hidden, collapsed, expanded.
# display:
#   details_mode: collapsed

# Fold per part: Fold state of thinking, tools, subagents or activity on its own.
# display:
#   sections: {}

# Full thinking: Show the model's thinking in full instead of a few lines.
# display:
#   reasoning_full: false

# Message reactions: Tell the agent about reactions you add to its messages.
# Applies from the next turn.
# display:
#   message_reactions: false

# Echo reasoning back: Send the model's earlier reasoning back to it on each request.
# Only needed for providers that require it.
# Applies to new sessions.
# agent:
#   reasoning_echo: false

# Arena layout: Settings for the arena view in the terminal UI.
# display:
#   arena: {}

# Background job notices: How much to report when a background command produces output.
# One of: concise, all, result, error, off.
# display:
#   background_process_notifications: concise

# Confirm steering: Confirm in chat when a message sent mid-turn steers the agent.
# display:
#   busy_steer_ack_enabled: true

# Busy chat text: What a plain chat message does while the agent is working.
# Overrides Enter while busy for chat apps only.
# One of: interrupt, queue.
# Unset: follows Enter while busy.
# display:
#   busy_text_mode: null

# Notice lifetime: Seconds before short system notices in chat apps delete themselves.
# Zero keeps them.
# display:
#   ephemeral_system_ttl: 0

# Report failed edits: List files the agent failed to edit at the end of a turn.
# display:
#   file_mutation_verifier: true

# Final answer markup: How markdown in the final answer is shown in the classic CLI.
# One of: strip, render, raw.
# display:
#   final_response_markdown: strip

# Friendly tool names: Describe tool calls in plain words in chat apps.
# Applies from the next turn.
# display:
#   friendly_tool_labels: true

# Inline diffs: Show file changes as a diff right in the transcript.
# display:
#   inline_diffs: true

# Mid-turn messages: Show the agent's short updates while it works.
# Needs Show commentary to be on as well in the terminal UI.
# display:
#   interim_assistant_messages: true

# Reasoning style: How shown reasoning is formatted in chat apps.
# One of: code, blockquote, subtext.
# display:
#   reasoning_style: code

# Show commentary: Show the agent's running commentary between tool calls.
# display:
#   show_commentary: true

# Spinner token flow: Show a live count of tokens flowing next to the spinner.
# display:
#   spinner_token_flow: true

# Stream replies: Show replies as they are written instead of all at once.
# display:
#   streaming: true

# Hide warning notices: Do not send warning notices to chat apps.
# display:
#   suppress_warning_notifications: false

# Tool preview length: Characters of each tool call shown in chat progress lines.
# Zero shows the built-in default length.
# Applies from the next turn.
# display:
#   tool_preview_length: 0

# Progress command: Allow the command that changes tool progress detail in chat apps.
# display:
#   tool_progress_command: false

# Tool progress grouping: Whether chat tool progress builds up in one message or many.
# One of: accumulate, separate.
# Applies from the next turn.
# display:
#   tool_progress_grouping: accumulate

# Explain odd endings: Say why a turn ended when it stops without a normal answer.
# display:
#   turn_completion_explainer: true

# Turn summary: Show a one-line summary of time and activity after each turn.
# display:
#   turn_summary: true

# Long call notices: Post a notice in chats while a long tool call keeps running.
# One of: on, generic, off.
# display:
#   long_running_notifications: 'on'

# Busy reply detail: Say what the agent is doing when a chat message arrives mid-turn.
# display:
#   busy_ack_detail: true

# Busy reply: Reply in a chat when a message arrives while the agent works.
# display:
#   busy_ack_enabled: true

# Clean up progress: Delete tool progress messages from a chat once the reply is in.
# display:
#   cleanup_progress: false

# Live status: What the chat app's status line says while the agent works.
# One of: full, verb, off.
# display:
#   live_status: full

# Thinking in chats: Post the model's thinking as progress messages in chats.
# display:
#   thinking_progress: false

# Busy message gap: Quiet time that closes a burst of chat messages sent mid-turn.
# Messages in one burst are queued as one.
# Restart the background service to apply.
# display:
#   busy_text_debounce_seconds: 0.35

# Busy message cap: Longest a burst of chat messages sent mid-turn is held.
# Restart the background service to apply.
# display:
#   busy_text_hard_cap_seconds: 1

# ============================================================
# Memory & sessions: What the agent remembers and how old sessions are kept.
# ============================================================

# Memory: Let the agent keep notes about your work between sessions.
# Applies to new sessions.
# memory:
#   memory_enabled: true

# Learn about me: Let the agent keep a short profile of you and your preferences.
# Applies to new sessions.
# memory:
#   user_profile_enabled: true

# Ask before saving: Ask you before the agent saves or changes a memory.
# memory:
#   write_approval: false

# Resume last session: Reopen your most recent session when the terminal UI starts.
# Restart the background service to apply.
# display:
#   tui_auto_resume_recent: false

# Delete old sessions: Delete sessions older than the keep time when the service starts.
# Restart the background service to apply.
# sessions:
#   auto_prune: false

# Memory notices: How much you are told when the agent saves to Memory.
# One of: on, verbose, off.
# display:
#   memory_notifications: 'on'

# Memory size limit: Most characters the agent's own notes in Memory may hold.
# Applies to new sessions.
# memory:
#   memory_char_limit: 2200

# Memory reminder spacing: Turns between reminders to the agent to save to Memory.
# Applies to new sessions.
# memory:
#   nudge_interval: 10

# Spill long recalls: Move long recalled Memory to a file instead of the prompt.
# Applies to outside Memory providers only.
# memory:
#   prefetch_spill_enabled: false

# Memory provider: Outside service used for Memory.
# Empty uses only the built-in Memory.
# memory:
#   provider: ''

# Profile size limit: Most characters the notes about you in Memory may hold.
# Applies to new sessions.
# memory:
#   user_char_limit: 1375

# Continue per terminal: Remember each terminal's session so it can be continued there.
# session:
#   terminal_continue: true

# Auto-archive sessions: Archive sessions that have sat idle for a while.
# sessions:
#   auto_archive: false

# Archive after idle: How long a session must be idle before it is archived.
# Pinned sessions are never archived.
# sessions:
#   auto_archive_days: 3

# Resume interrupted turns: Pick up a turn automatically after the app stopped mid-turn.
# sessions:
#   auto_continue:
#     enabled: true

# Resume window: How recent an interrupted turn must be to resume itself.
# sessions:
#   auto_continue:
#     freshness_minutes: 15

# Resume attempts: Times one interrupted turn is resumed before giving up.
# sessions:
#   auto_continue:
#     max_attempts: 2

# Search CJK text: Make Chinese, Japanese and Korean text searchable in sessions.
# sessions:
#   cjk_fts: true

# Search tune-up notice: Whether to suggest tidying a large session search index.
# One of: advise, off.
# sessions:
#   fts_optimize_notice: advise

# Export size limit: Largest session, in messages, that can be exported in memory.
# Zero turns the guard off.
# sessions:
#   max_export_messages: 20000

# Resume size limit: Largest session, in messages, that can be resumed.
# Zero turns the guard off.
# sessions:
#   max_resume_messages: 20000

# Cleanup spacing: Least time between automatic archive or cleanup runs.
# sessions:
#   min_interval_hours: 24

# Compact spacing: Least time between compactions of the session database.
# sessions:
#   min_vacuum_interval_days: 30

# Abandoned session grace: How long an abandoned session waits before it is marked ended.
# Zero ends it right away.
# sessions:
#   orphan_end_grace_s: 300

# Keep old sessions: Age after which old sessions are deleted by automatic cleanup.
# Applies only while Delete old sessions is on.
# sessions:
#   retention_days: 90

# Slow search mark: Searches slower than this are written to the log.
# sessions:
#   search_slow_ms: 1000

# List subagent sessions: Include sessions started by subagents in session lists.
# sessions:
#   show_subagents: false

# Close stale sessions: At startup, close sessions left open by a crash or shutdown.
# sessions:
#   startup_orphan_sweep: true

# Compact after cleanup: Shrink the session database after old sessions are deleted.
# sessions:
#   vacuum_after_prune: true

# Idle disconnect limit: How long a disconnected session may sit idle before it is closed.
# Restart the background service to apply.
# sessions:
#   ws_orphan_activity_stale_s: 600

# Disconnect grace: How long a session is kept after its window disconnects.
# Zero keeps it parked until it is reopened.
# Restart the background service to apply.
# sessions:
#   ws_orphan_reap_grace_s: 20

# Sessions per window: Most sessions one window keeps open at once.
# sessions:
#   max_live_per_connection: 12

# Open session limit: Most sessions open at once across every window of this profile.
# sessions:
#   max_live_per_profile: 32

# ============================================================
# Chat apps: Chat apps, scheduled jobs and their replies.
# ============================================================

# Reply footer: Add a line with model and context use under chat app replies.
# display:
#   runtime_footer:
#     enabled: false

# Human-like delay: Wait a moment before replying in chat apps, like a person typing.
# One of: off, natural, custom.
# Restart the background service to apply.
# human_delay:
#   mode: 'off'

# Voice per chat: Each chat's own choice of voice replies, set by /voice there.
# Chats missing here follow Speak replies.
# voice:
#   chat_modes: {}

# Chat app display: Display settings one chat app uses instead of the global ones.
# Keyed by chat app. Only the settings that say so take an override here.
# display:
#   platforms: {}

# Agent scheduling: Let scheduled jobs create and change other scheduled jobs.
# cron:
#   allow_agent_scheduling: false

# Catch up missed: Run jobs missed while the app was off, once when it returns.
# cron:
#   catch_up_missed: true

# Cleanup wait: How long to wait for cleanup after a scheduled job finishes.
# Cleanup that runs longer is abandoned.
# cron:
#   cleanup_timeout_seconds: 10

# Delivery notices: Send a notice to the chat when a scheduled result is delivered.
# cron:
#   delivery:
#     notify: true

# Failure nudge after: Failed runs in a row before you get a nudge about a job.
# cron:
#   failure_nudge_threshold: 3

# Repeat alert gap: Wait between repeat alerts for a job that keeps failing.
# Zero alerts on every failed run.
# cron:
#   failure_repeat_alert_hours: 6

# Stuck job limit: Minimum time a running job gets before it counts as stuck.
# Unset falls back to the matching environment variable, then 30 minutes.
# Unset: 30 minutes.
# cron:
#   inflight_max_minutes: null

# Parallel jobs: Most scheduled jobs that run at the same time.
# Zero also means no limit. The matching environment variable wins.
# Unset: no limit.
# cron:
#   max_parallel_jobs: null

# Media send wait: How long to wait when sending each file from a scheduled job.
# cron:
#   media_send_timeout_seconds: 300

# Mirror results: Also add scheduled results to the chat session they were sent to.
# A job can override this.
# cron:
#   mirror_delivery: false

# Allow everyone: Buzz: let anyone in its channels talk to it.
# buzz:
#   allow_all_users: false

# Allowed people: Buzz: public keys of people allowed to talk to it.
# Restart the background service to apply.
# buzz:
#   allowed_users: []

# Channels: Buzz: channels it listens in.
# Restart the background service to apply.
# buzz:
#   channels: []

# Buzz program: Buzz: path of the buzz program; empty finds it on the PATH.
# Restart the background service to apply.
# buzz:
#   cli_path: ''

# Poll interval: Buzz: seconds between checks for new messages when polling.
# Unset: the built-in interval.
# Restart the background service to apply.
# buzz:
#   poll_interval: null

# React only to: Buzz: public keys whose messages get a reaction but no reply.
# Restart the background service to apply.
# buzz:
#   reaction_only_users: []

# Relay address: Buzz: address of the relay the bot talks through.
# Restart the background service to apply.
# buzz:
#   relay_url: ''

# Reply in thread: Buzz: answer in a thread under the message; off answers in place.
# Restart the background service to apply.
# buzz:
#   reply_in_thread: true

# Reply quoting: Buzz: which parts of a reply point back at your message.
# One of: first, all, off.
# Restart the background service to apply.
# buzz:
#   reply_to_mode: first

# Require mention: Buzz: answer in channels only when someone mentions it.
# Restart the background service to apply.
# buzz:
#   require_mention: true

# Connection type: Buzz: how it receives messages from the relay.
# One of: auto, websocket, poll.
# Restart the background service to apply.
# buzz:
#   transport: auto

# Late start allowance: How late a scheduled job may still start after its time.
# cron:
#   misfire_grace_minutes: 10

# Job model: Model scheduled jobs use when they do not pick their own.
# Blank follows your main model.
# cron:
#   model: ''

# Job model provider: Provider of the job model.
# Empty uses your main provider.
# cron:
#   model_provider: ''

# Kept job outputs: Output files kept for each scheduled job.
# cron:
#   output_retention: 50

# Check before run: Check a job needs (skills, tools, logins) are ready before it runs.
# cron:
#   preflight: true

# Scheduler plugin: Scheduler plugin that fires jobs.
# Empty uses the built-in scheduler.
# cron:
#   provider: ''

# Safe restart only: Refuse to run jobs that a restart could cut off.
# cron:
#   require_restart_safe_scope: false

# Retry when offline: Retry a job later when the network or model was unreachable.
# cron:
#   retry_unreachable: true

# Job script limit: Longest a job pre-run script may run.
# cron:
#   script_timeout_seconds: 3600

# History open wait: How long a job waits to open the session history.
# Zero waits forever. The matching environment variable wins.
# cron:
#   session_db_timeout_seconds: 10

# Direct send wait: How long to wait when a job sends outside a chat session.
# Zero or less uses the default.
# cron:
#   standalone_send_timeout_seconds: 60

# Wrap results: Add a header and footer around scheduled results sent to chat.
# cron:
#   wrap_response: true

# Allow everyone: Discord: let anyone who can see the bot talk to it.
# discord:
#   allow_all_users: false

# Answer bots: Discord: which messages from other bots it answers.
# One of: none, mentions, all.
# discord:
#   allow_bots: none

# Allowed people: Discord: user IDs or names allowed to talk to it; * allows everyone.
# Empty leaves access to pairing and the shared allow list.
# discord:
#   allow_from: []

# Allowed channels: Discord: only answer in these channel IDs.
# discord:
#   allowed_channels: []

# Allowed roles: Discord: server role IDs whose members may talk to it.
# discord:
#   allowed_roles: []

# Ignored channels: Discord: channel IDs or names it never reads.
# discord:
#   ignored_channels: []

# No thread channels: Discord: channels where it answers in place, without a thread.
# discord:
#   no_thread_channels: []

# Approval mentions: Discord: mention allowed users on approval requests.
# discord:
#   approval_mentions: false

# Auto threads: Discord: start a thread for each new conversation.
# discord:
#   auto_thread: true

# Bots must mention: Discord: other bots must mention it inside their message.
# discord:
#   bots_require_inline_mention: true

# Channel prompts: Discord: extra instructions for chosen channels.
# Maps channel ID to the instruction text.
# Restart the background service to apply.
# discord:
#   channel_prompts: {}

# DM role server: Discord: server whose roles allow direct messages.
# Blank lets roles apply only inside servers.
# Restart the background service to apply.
# discord:
#   dm_role_auth_guild: ''

# Free channel threads: Discord: start threads in channels where it replies without mention.
# discord:
#   free_response_auto_thread: false

# Free reply channels: Discord: channel IDs where it replies without a mention.
# discord:
#   free_response_channels: []

# Read recent history: Discord: read earlier messages for context when it joins a chat.
# discord:
#   history_backfill: true

# History messages: Discord: most earlier messages read for context.
# discord:
#   history_backfill_limit: 50

# Attachment limit: Discord: largest file it downloads from a message.
# Zero means no limit.
# discord:
#   max_attachment_bytes: 33554432

# Catch-up channels: Discord: channel IDs checked for messages missed while offline.
# Blank checks allowed and free reply channels.
# discord:
#   missed_message_backfill:
#     channels: []

# Catch up messages: Discord: answer messages missed while the service was down.
# Restart the background service to apply.
# discord:
#   missed_message_backfill:
#     enabled: false

# Catch-up scan size: Discord: most recent messages checked per channel when catching up.
# Restart the background service to apply.
# discord:
#   missed_message_backfill:
#     limit: 100

# Catch-up retries: Discord: tries per missed message before giving up.
# Restart the background service to apply.
# discord:
#   missed_message_backfill:
#     max_attempts: 3

# Catch-up replies: Discord: most missed messages answered per catch-up.
# Restart the background service to apply.
# discord:
#   missed_message_backfill:
#     max_dispatches: 10

# Catch-up window: Discord: how far back missed messages are still answered.
# Restart the background service to apply.
# discord:
#   missed_message_backfill:
#     window_seconds: 21600

# Reactions: Discord: react to messages while working on them.
# discord:
#   reactions: true

# Require mention: Discord: only answer in servers when mentioned.
# discord:
#   require_mention: true

# Allowed server actions: Discord: server actions the agent may take.
# Comma separated action names. Empty allows all, and unknown names are ignored.
# discord:
#   server_actions: ''

# Threads need mention: Discord: also require a mention inside threads.
# discord:
#   thread_require_mention: false

# Voice idle leave: Discord: leave a voice channel after this much silence.
# Zero never leaves.
# Restart the background service to apply.
# discord:
#   voice_channel_inactivity_timeout_seconds: 300

# Spoken acknowledgements: Discord: say a short phrase when starting on a voice request.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     ack_enabled: true

# Acknowledgement phrases: Discord: phrases spoken while it works on a voice request.
# Blank list uses the built-in phrases.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     ack_phrases:
#       - Let me look into that.
#       - One moment.
#       - Checking on that now.
#       - Give me a sec.
#       - On it.

# Ambient sound: Discord: play background sound while it works on a voice request.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     ambient_enabled: true

# Ambient volume: Discord: volume of the background sound.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     ambient_gain: 0.18

# Ambient sound file: Discord: sound file played while it works.
# Empty uses the built-in sound.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     ambient_path: ''

# Ambient duck volume: Discord: background volume while it speaks.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     duck_gain: 0.06

# Voice effects: Discord: use sound effects and spoken acknowledgements in voice.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     enabled: false

# Speech lead silence: Discord: silence added before speech so the start is not clipped.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     lead_silence_ms: 0

# Speech volume: Discord: volume of spoken replies.
# Restart the background service to apply.
# discord:
#   voice_fx:
#     speech_gain: 1.0

# Voice playback wait: Discord: shortest wait for spoken audio to finish playing.
# Restart the background service to apply.
# discord:
#   voice_playback_timeout_seconds: 120

# Silent link limit: Discord: reconnect when no events arrive for this long.
# Zero or less turns this check off.
# Restart the background service to apply.
# discord:
#   websocket_event_max_silence_seconds: 14400

# Heartbeat reply limit: Discord: reconnect when Discord stops answering heartbeats.
# Zero or less turns this check off.
# Restart the background service to apply.
# discord:
#   websocket_heartbeat_ack_max_age_seconds: 60

# Link check failures: Discord: failed link checks in a row before reconnecting.
# Restart the background service to apply.
# discord:
#   websocket_liveness_failure_threshold: 2

# Link check interval: Discord: time between connection health checks.
# Restart the background service to apply.
# discord:
#   websocket_liveness_interval_seconds: 15

# Link latency limit: Discord: reconnect when the connection is slower than this.
# Zero or less turns this check off.
# Restart the background service to apply.
# discord:
#   websocket_max_latency_seconds: 30

# Footer fields: Details shown in the footer line under chat replies.
# Choose from model, served_model, context_pct, latency and cwd, in order.
# display:
#   runtime_footer:
#     fields:
#       - model
#       - context_pct
#       - cwd

# Allow all users: Let anyone message the chat apps, without an allowed list.
# gateway:
#   allow_all_users: false

# API output cap: API server: longest tool output kept in saved conversation history.
# Zero keeps full tool output.
# Restart the background service to apply.
# gateway:
#   api_server:
#     history_tool_output_max_chars: 0

# API parallel runs: API server: most requests answered at the same time.
# Restart the background service to apply.
# gateway:
#   api_server:
#     max_concurrent_runs: 10

# Auto merge profiles: Let the background service merge profiles into one when it can.
# gateway:
#   auto_multiplex_migration: true

# Bot loop pause: How long a chat is ignored after a bot-to-bot loop is caught.
# gateway:
#   bot_loop_guard:
#     cooldown_seconds: 600

# Bot loop guard: Stop replying when bots keep triggering each other in a chat.
# gateway:
#   bot_loop_guard:
#     enabled: true

# Bot loop messages: Bot messages allowed in the window before the guard trips.
# gateway:
#   bot_loop_guard:
#     max_events: 20

# Bot loop window: Time span over which bot messages are counted.
# gateway:
#   bot_loop_guard:
#     window_seconds: 300

# Delivery records: Record sent replies so a restart does not lose or repeat them.
# gateway:
#   delivery_ledger: true

# Hang watchdog: Detect a frozen background service and restart it.
# Restart the background service to apply.
# gateway:
#   loop_watchdog: true

# Watchdog strikes: Failed health probes in a row before the watchdog acts.
# Restart the background service to apply.
# gateway:
#   loop_watchdog_max_strikes: 3

# Watchdog interval: Time between watchdog health probes.
# Restart the background service to apply.
# gateway:
#   loop_watchdog_probe_interval_s: 30

# Watchdog probe wait: How long a health probe may take before it counts as failed.
# Restart the background service to apply.
# gateway:
#   loop_watchdog_probe_timeout_s: 10

# Managed workers: Run chat sessions in separate worker processes under a fixed policy.
# gateway:
#   managed_workers: false

# Incoming file limit: Largest file accepted from a chat message.
# gateway:
#   max_inbound_media_bytes: 134217728

# Sendable folders: Extra folders whose files may be sent to chats.
# Files outside allowed folders are dropped.
# Restart the background service to apply.
# gateway:
#   media_delivery_allow_dirs: []

# Message timestamps: Show the agent the time each chat message was sent.
# gateway:
#   message_timestamps:
#     enabled: false

# Merge profiles: Serve every profile from one background service.
# gateway:
#   multiplex_profiles: true

# Chat connect wait: How long each chat app gets to connect at startup.
# Restart the background service to apply.
# gateway:
#   platform_connect_timeout: 30

# Profile routes: Rules that send particular chats to a particular profile.
# Each entry names a chat and the profile that handles it.
# Restart the background service to apply.
# gateway:
#   profile_routes: []

# Chat proxy: Proxy address for chat app connections.
# Empty connects directly.
# gateway:
#   proxy_url: ''

# Restart storm starts: Starts allowed in the window before startup is delayed.
# Restart the background service to apply.
# gateway:
#   respawn_storm:
#     max_starts: 5

# Restart storm window: Time span over which service starts are counted.
# Restart the background service to apply.
# gateway:
#   respawn_storm:
#     window_seconds: 120

# Restart loop gap: Longest gap between restarts that still counts as a loop.
# gateway:
#   restart_loop_guard:
#     max_gap_seconds: 300

# Restart loop count: Restarts in the window before the loop guard stops them.
# gateway:
#   restart_loop_guard:
#     max_restarts: 3

# Restart loop window: Time span over which restarts are counted.
# gateway:
#   restart_loop_guard:
#     window_seconds: 60

# Idle stop delay: How long the service waits with no work before it stops itself.
# gateway:
#   scale_to_zero:
#     idle_timeout_minutes: 2

# Service choice: Your answer about installing the background service.
# Set by setup. Change it only to be asked again.
# One of: install, decline.
# Unset: not asked yet.
# gateway:
#   service_install_choice: null

# Stop grace time: How long a running turn gets to stop when the service is signaled.
# gateway:
#   signal_interrupt_grace_timeout: 1

# Own service: Run this profile's own background service instead of sharing one.
# Older option. Merge profiles is the better choice.
# gateway:
#   standalone: false

# Startup watchdog: Restart the service if it never finishes starting.
# Restart the background service to apply.
# The ICEBATH_STARTUP_WATCHDOG environment variable overrides it.
# gateway:
#   startup_watchdog: true

# Startup time limit: How long startup may take before the watchdog acts.
# Restart the background service to apply.
# The ICEBATH_STARTUP_WATCHDOG_TIMEOUT_S environment variable overrides it.
# gateway:
#   startup_watchdog_timeout_seconds: 300

# Strict file sending: Refuse to send files unless their folder is explicitly allowed.
# Restart the background service to apply.
# gateway:
#   strict: false

# System watchdog time: Seconds between liveness pings to the system service manager.
# Unset: off.
# Restart the background service to apply.
# gateway:
#   systemd_watchdog_seconds: null

# Use proxy settings: Honor proxy and certificate environment variables for chat apps.
# gateway:
#   trust_env: true

# Trust recent files: Allow sending just-created files from outside allowed folders.
# Restart the background service to apply.
# gateway:
#   trust_recent_files: true

# All chats down: What the background service does once every chat app has dropped.
# One of: exit, stay_alive.
# Restart the background service to apply.
# gateway:
#   on_all_adapters_down: exit

# Recent file window: How recent a file must be to count as just created.
# Restart the background service to apply.
# gateway:
#   trust_recent_files_seconds: 600

# Room link address: Address other machines use to reach the rooms shared from here.
# Plain http is allowed only on this machine. A named profile without its own takes the main profile's.
# Unset: rooms are not offered to other machines.
# gateway:
#   room_link_url: null

# Idle exit time: A hand-started service quits after this long with no work.
# Zero never quits.
# gateway:
#   unmanaged_idle_exit_seconds: 600

# Write session index: Keep a readable index file of chat sessions.
# Restart the background service to apply.
# gateway:
#   write_sessions_json: true

# Room reply limit: Most messages the agents may post in one room discussion.
# hosted_rooms:
#   discussion:
#     max_messages: 10

# Room discussion rounds: Most rounds of replies in one room discussion.
# hosted_rooms:
#   discussion:
#     max_rounds: 3

# Longest typing pause: Longest pause before a reply when custom pacing is on.
# Restart the background service to apply.
# human_delay:
#   max_ms: 2500

# Shortest typing pause: Shortest pause before a reply when custom pacing is on.
# Restart the background service to apply.
# human_delay:
#   min_ms: 800

# Allowed rooms: Matrix: only answer in these room IDs.
# Restart the background service to apply.
# matrix:
#   allowed_rooms: []

# Allowed people: Matrix: user IDs allowed to talk to it; * allows everyone.
# Restart the background service to apply.
# matrix:
#   allowed_users: []

# Auto threads: Matrix: answer each new conversation in its own thread.
# Restart the background service to apply.
# matrix:
#   auto_thread: true

# Device ID: Matrix: device ID the bot signs in as, kept for encryption.
# Restart the background service to apply.
# matrix:
#   device_id: ''

# Threads in DMs: Matrix: open a thread when mentioned in a direct chat.
# Restart the background service to apply.
# matrix:
#   dm_mention_threads: false

# Homeserver: Matrix: address of the server the bot account lives on.
# Restart the background service to apply.
# matrix:
#   homeserver: ''

# Ignored senders: Matrix: patterns of user IDs whose messages it ignores.
# Restart the background service to apply.
# matrix:
#   ignore_user_patterns: []

# Message length: Matrix: longest message it sends before splitting a reply.
# Unset uses the length the server allows.
# Unset: the server's limit.
# Restart the background service to apply.
# matrix:
#   max_message_length: null

# Read notices: Matrix: treat notice messages, which bots send, as messages to it.
# Restart the background service to apply.
# matrix:
#   process_notices: false

# Conversation scope: Matrix: whether a conversation covers a whole room or one thread.
# One of: auto, room, thread.
# Restart the background service to apply.
# matrix:
#   session_scope: auto

# Bot user ID: Matrix: user ID of the bot account, such as @bot:example.org.
# Restart the background service to apply.
# matrix:
#   user_id: ''

# Free reply rooms: Matrix: room IDs where it replies without a mention.
# Restart the background service to apply.
# matrix:
#   free_response_rooms: []

# Require mention: Matrix: only answer in rooms when mentioned.
# Restart the background service to apply.
# matrix:
#   require_mention: true

# Allowed channels: Mattermost: only answer in these channel IDs.
# mattermost:
#   allowed_channels: []

# Channel prompts: Mattermost: extra instructions for chosen channels.
# Maps channel ID to the instruction text.
# Restart the background service to apply.
# mattermost:
#   channel_prompts: {}

# Free reply channels: Mattermost: channel IDs where it replies without a mention.
# mattermost:
#   free_response_channels: []

# Require mention: Mattermost: only answer in channels when mentioned.
# mattermost:
#   require_mention: true

# Platform hints: Replace or extend the built-in tips about each chat app.
# Keyed by app name. Each entry replaces or extends that app's built-in hint.
# Applies to new sessions.
# platform_hints: {}

# Allowed channels: Slack: only answer in these channel IDs.
# slack:
#   allowed_channels: []

# Channel prompts: Slack: extra instructions for chosen channels.
# Maps channel ID to the instruction text.
# Restart the background service to apply.
# slack:
#   channel_prompts: {}

# Free reply channels: Slack: channel IDs where it replies without a mention.
# slack:
#   free_response_channels: []

# Skip others' mentions: Slack: ignore messages that mention someone else but not it.
# slack:
#   ignore_other_user_mentions: false

# Require mention: Slack: only answer in channels when mentioned.
# slack:
#   require_mention: true

# Mention-only channels: Slack: channel IDs that always need a mention.
# slack:
#   require_mention_channels: []

# Threads need mention: Slack: also require a mention inside threads.
# slack:
#   thread_require_mention: false

# Stream batch size: Characters gathered before each streamed update is shown.
# Restart the background service to apply.
# streaming:
#   buffer_threshold: 24

# Stream cursor: Marker shown at the end of a reply while it streams.
# Restart the background service to apply.
# streaming:
#   cursor: ' ▉'

# Stream update gap: Seconds between updates to a streamed reply.
# Restart the background service to apply.
# streaming:
#   edit_interval: 0.8

# Stream replies: Show chat replies as they are written instead of all at once.
# Each chat app can switch it off separately.
# Restart the background service to apply.
# streaming:
#   enabled: false

# Fresh final reply: Send the final reply as a new message after this long.
# Zero edits the streamed message instead.
# Restart the background service to apply.
# streaming:
#   fresh_final_after_seconds: 0

# Stream method: How streamed replies are delivered.
# One of: auto, edit, draft, off.
# Restart the background service to apply.
# streaming:
#   transport: auto

# Allowed chats: Telegram: only answer in these chat IDs.
# telegram:
#   allowed_chats: []

# Channel prompts: Telegram: extra instructions for chosen chats.
# Maps chat ID to the instruction text.
# Restart the background service to apply.
# telegram:
#   channel_prompts: {}

# CJK rich text: Telegram: allow rich formatting in Chinese, Japanese and Korean text.
# Restart the background service to apply.
# telegram:
#   extra:
#     allow_cjk_rich_messages: false

# Move DM topics: Telegram: move a direct message conversation into its own topic.
# Restart the background service to apply.
# telegram:
#   extra:
#     dm_topic_auto_transfer: false

# Rich drafts: Telegram: use rich formatting in streamed drafts.
# Restart the background service to apply.
# telegram:
#   extra:
#     rich_drafts: false

# Rich messages: Telegram: use rich formatting in replies.
# Restart the background service to apply.
# telegram:
#   extra:
#     rich_messages: false

# Answer bots: Telegram: which messages from other bots it answers.
# One of: none, mentions, all.
# telegram:
#   allow_bots: none

# Allowed people: Telegram: user IDs allowed to talk to it; * allows everyone.
# Empty leaves access to pairing and the shared allow list.
# telegram:
#   allow_from: []

# Allowed topics: Telegram: the only forum topics it answers in.
# Each item is chat:topic. Empty allows every topic.
# telegram:
#   allowed_topics: []

# Bots must mention: Telegram: other bots must mention it to get an answer.
# telegram:
#   bots_require_mention: false

# Other bot mentions: Telegram: skip messages that mention only another bot.
# telegram:
#   exclusive_bot_mentions: true

# Free reply chats: Telegram: chats where it answers without being mentioned.
# telegram:
#   free_response_chats: []

# Free reply topics: Telegram: forum topics where it answers without being mentioned.
# Each item is chat:topic, such as -100123:7.
# telegram:
#   free_response_topics: []

# Allowed in groups: Telegram: user IDs allowed to talk to it in groups.
# telegram:
#   group_allow_from: []

# Open groups: Telegram: group chat IDs where everyone may talk to it.
# telegram:
#   group_allowed_chats: []

# Guest mode: Telegram: answer when someone brings the bot into a chat as a guest.
# telegram:
#   guest_mode: false

# Ignored topics: Telegram: forum topic numbers it never reads.
# telegram:
#   ignored_threads: []

# Mention words: Telegram: words that count as a mention besides the bot's name.
# Each item is a pattern matched against the message text.
# telegram:
#   mention_patterns: []

# Reply alerts: Telegram: which replies make the phone buzz.
# One of: important, all.
# telegram:
#   notifications: important

# Read group talk: Telegram: keep group messages that do not mention it as context.
# It still answers only when mentioned.
# telegram:
#   observe_unmentioned_group_messages: false

# Reactions: Telegram: react to messages while working on them.
# telegram:
#   reactions: false

# Require mention: Telegram: answer in groups only when someone mentions the bot.
# telegram:
#   require_mention: false

# Allowed people: WhatsApp: phone numbers allowed to talk to it; * allows everyone.
# whatsapp:
#   allow_from: []

# Direct chat access: WhatsApp: who may talk to it in direct chats.
# One of: pairing, allowlist, open, disabled.
# Restart the background service to apply.
# whatsapp:
#   dm_policy: pairing

# Free reply chats: WhatsApp: chats where it answers without being mentioned.
# whatsapp:
#   free_response_chats: []

# Allowed in groups: WhatsApp: group IDs or numbers allowed to talk to it in groups.
# whatsapp:
#   group_allow_from: []

# Group access: WhatsApp: who may talk to it in groups.
# One of: pairing, allowlist, open, disabled.
# Restart the background service to apply.
# whatsapp:
#   group_policy: pairing

# Mention words: WhatsApp: words that count as a mention besides its name.
# whatsapp:
#   mention_patterns: []

# Require mention: WhatsApp: answer in groups only when someone mentions it.
# whatsapp:
#   require_mention: false

# API version: WhatsApp Business: version of Meta's Graph API to call.
# Restart the background service to apply.
# whatsapp_cloud:
#   api_version: ''

# App ID: WhatsApp Business: ID of your Meta app.
# Restart the background service to apply.
# whatsapp_cloud:
#   app_id: ''

# Phone number ID: WhatsApp Business: phone number ID from the Meta app dashboard.
# Restart the background service to apply.
# whatsapp_cloud:
#   phone_number_id: ''

# Business account: WhatsApp Business: ID of the business account.
# Restart the background service to apply.
# whatsapp_cloud:
#   waba_id: ''

# Listen address: WhatsApp Business: address the message receiver listens on.
# Restart the background service to apply.
# whatsapp_cloud:
#   webhook_host: ''

# Webhook path: WhatsApp Business: path the message receiver answers on.
# Restart the background service to apply.
# whatsapp_cloud:
#   webhook_path: ''

# Listen port: WhatsApp Business: port the message receiver listens on.
# Unset: the built-in port.
# Restart the background service to apply.
# whatsapp_cloud:
#   webhook_port: null

# Robot ID: WeCom: ID of the smart robot the bot runs as.
# Restart the background service to apply.
# wecom:
#   bot_id: ''

# Connection address: WeCom: address of the live connection; empty uses WeCom's own.
# Restart the background service to apply.
# wecom:
#   websocket_url: ''

# App ID: WeCom app: agent ID of the self-built app.
# Restart the background service to apply.
# wecom_callback:
#   agent_id: ''

# Company ID: WeCom app: ID of your company in WeCom.
# Restart the background service to apply.
# wecom_callback:
#   corp_id: ''

# Listen address: WeCom app: address the message receiver listens on.
# Restart the background service to apply.
# wecom_callback:
#   host: ''

# Listen port: WeCom app: port the message receiver listens on.
# Restart the background service to apply.
# wecom_callback:
#   port: 8645

# Strict mentions: Slack: answer in channels only when mentioned in that very message.
# slack:
#   strict_mention: false

# Refuse direct messages: Slack: ignore direct messages and answer only in channels.
# slack:
#   disable_dms: false

# Quiet thread follow-ups: Slack: stay silent on thread replies not addressed to it.
# slack:
#   thread_followup_silence: false

# Ignored channels: Slack: channel IDs it never answers in.
# slack:
#   ignored_channels: []

# Progress reactions: Slack: react to a message while working on it and when done.
# slack:
#   reactions: true

# Reaction triggers: Slack: emoji that, added to a message, hand it to the agent.
# All, or a star, takes every emoji.
# Unset: reactions hand nothing over.
# slack:
#   reaction_triggers: null

# Reaction target: Slack: channel, or channel:thread, that reaction hand-offs go to.
# Unset: the channel the reaction was added in.
# slack:
#   reaction_trigger_target: null

# Other bots: Slack: whether messages from other bots are answered.
# One of: none, mentions, all.
# slack:
#   allow_bots: none

# Server address: Mattermost: address of your Mattermost server.
# For example https://chat.example.com. The bot token stays with your other secrets.
# Unset: not connected.
# Restart the background service to apply.
# mattermost:
#   url: null

# Require mention: DingTalk: only answer in group chats when mentioned.
# dingtalk:
#   require_mention: false

# Wake patterns: DingTalk: patterns in a message that count as mentioning it.
# Regular expressions, matched without regard to case.
# Restart the background service to apply.
# dingtalk:
#   mention_patterns: []

# Free reply chats: DingTalk: group chat IDs where it replies without a mention.
# dingtalk:
#   free_response_chats: []

# Allowed chats: DingTalk: only answer in these group chat IDs.
# Empty allows every group chat.
# dingtalk:
#   allowed_chats: []

# Allowed users: DingTalk: user or staff IDs allowed to use the bot.
# Empty or a star allows everyone.
# Restart the background service to apply.
# dingtalk:
#   allowed_users: []

# Cloud: Feishu: whether the app is on Feishu in China or on Lark.
# One of: feishu, lark.
# Restart the background service to apply.
# feishu:
#   domain: feishu

# Connection: Feishu: receive messages over a socket or through a web address.
# One of: websocket, webhook.
# Restart the background service to apply.
# feishu:
#   connection_mode: websocket

# Other bots: Feishu: whether messages from other bots are answered.
# One of: none, mentions, all.
# Restart the background service to apply.
# feishu:
#   allow_bots: none

# Listener address: BlueBubbles: address the listener for new messages binds to.
# Restart the background service to apply.
# bluebubbles:
#   webhook_host: 127.0.0.1

# Listener port: BlueBubbles: port the listener for new messages binds to.
# Restart the background service to apply.
# bluebubbles:
#   webhook_port: 8645

# Listener path: BlueBubbles: path the server sends new messages to.
# Restart the background service to apply.
# bluebubbles:
#   webhook_path: /bluebubbles-webhook

# Read receipts: BlueBubbles: mark messages as read once they are handled.
# Restart the background service to apply.
# bluebubbles:
#   send_read_receipts: true

# Require mention: BlueBubbles: only answer in group chats when called by name.
# Restart the background service to apply.
# bluebubbles:
#   require_mention: false

# Wake patterns: BlueBubbles: patterns in a group message that count as calling it.
# Regular expressions, matched without regard to case.
# Unset: the built-in patterns.
# Restart the background service to apply.
# bluebubbles:
#   mention_patterns: null

# Service address: Weixin: address of the iLink service the account talks to.
# Signing in by QR code sets it.
# Restart the background service to apply.
# weixin:
#   base_url: https://ilinkai.weixin.qq.com

# Media address: Weixin: address media files are downloaded from.
# Restart the background service to apply.
# weixin:
#   cdn_base_url: https://novac2c.cdn.weixin.qq.com/c2c

# Split lines: Weixin: send each line of a reply as its own message.
# Restart the background service to apply.
# weixin:
#   split_multiline_messages: false

# Direct messages: Weixin: who may message the bot directly.
# One of: pairing, allowlist, open, disabled.
# Restart the background service to apply.
# weixin:
#   dm_policy: pairing

# Allowed people: Weixin: user IDs allowed to message the bot directly.
# Restart the background service to apply.
# weixin:
#   allow_from: []

# Group chats: Weixin: which group chats the bot answers in.
# One of: pairing, allowlist, open, disabled.
# Restart the background service to apply.
# weixin:
#   group_policy: disabled

# Allowed groups: Weixin: group chat IDs the bot answers in.
# Restart the background service to apply.
# weixin:
#   group_allow_from: []

# Allowed people: QQ: user OpenIDs allowed to message the bot directly.
# Restart the background service to apply.
# qqbot:
#   allow_from: []

# Allowed groups: QQ: group OpenIDs the bot answers in.
# Restart the background service to apply.
# qqbot:
#   group_allow_from: []

# Skip stories: Signal: ignore story posts from contacts.
# Restart the background service to apply.
# signal:
#   ignore_stories: true

# Require mention: Signal: only answer in group chats when mentioned.
# Restart the background service to apply.
# signal:
#   require_mention: false

# Socket address: Yuanbao: address of the socket the bot receives messages on.
# Restart the background service to apply.
# yuanbao:
#   ws_url: wss://bot-wss.yuanbao.tencent.com/wss/connection

# Service address: Yuanbao: address of the bot service that signs the bot in.
# Restart the background service to apply.
# yuanbao:
#   api_domain: https://bot.yuanbao.tencent.com

# Service route: Yuanbao: which service environment the bot's requests go to.
# Unset: the production service.
# Restart the background service to apply.
# yuanbao:
#   route_env: null

# Direct messages: Yuanbao: who may message the bot directly.
# One of: pairing, allowlist, open, disabled.
# Restart the background service to apply.
# yuanbao:
#   dm_policy: pairing

# Allowed people: Yuanbao: user IDs allowed to message the bot directly.
# Restart the background service to apply.
# yuanbao:
#   dm_allow_from: []

# Group chats: Yuanbao: which group chats the bot answers in.
# One of: pairing, allowlist, open, disabled.
# Restart the background service to apply.
# yuanbao:
#   group_policy: pairing

# Allowed groups: Yuanbao: group IDs the bot answers in.
# Restart the background service to apply.
# yuanbao:
#   group_allow_from: []

# Chat app connections: Each chat app's connection: on or off, tokens and options.
# Restart the background service to apply.
# platforms: {}

# Group per person: In group chats, keep a separate conversation per person.
# Restart the background service to apply.
# gateway:
#   group_sessions_per_user: true

# Thread per person: In threads, keep a separate conversation per person.
# Restart the background service to apply.
# gateway:
#   thread_sessions_per_user: false

# Keep local log: Keep a local copy of chat app conversations.
# Restart the background service to apply.
# gateway:
#   always_log_local: true

# Skip silence notes: Do not send replies that only say nothing happened.
# Restart the background service to apply.
# gateway:
#   filter_silence_narration: true

# Reset words: Messages that start a new conversation in a chat app.
# Restart the background service to apply.
# gateway:
#   reset_triggers:
#     - /new
#     - /reset

# Strangers: What the bot does when someone it does not know writes.
# One of: pair, ignore, decline.
# Restart the background service to apply.
# gateway:
#   unauthorized_dm_behavior: pair

# Decline message: Reply sent to strangers when Strangers is Decline.
# Restart the background service to apply.
# gateway:
#   unauthorized_dm_decline_message: ''

# ============================================================
# System: Timeouts, logging, updates and limits.
# ============================================================

# Idle session lifetime: How long an unused agent stays loaded before it can be freed.
# agent:
#   agent_cache:
#     idle_ttl_secs: 3600

# Frees per sweep: Most idle agents freed in one cleanup sweep.
# agent:
#   agent_cache:
#     max_evictions_per_pass: 16

# Loaded agents: How many agents stay loaded before the oldest idle ones are freed.
# agent:
#   agent_cache:
#     max_size: 128

# Memory ceiling: Memory use in MB above which idle agents are freed.
# Use auto to pick from the machine's memory, a number of MB, or off to never free by memory.
# agent:
#   agent_cache:
#     memory_high_mb: auto

# Keep recent agents: Most recently used agents that are never freed.
# agent:
#   agent_cache:
#     protect_recent: 8

# Model retries: Times a failed model request is retried before giving up.
# Applies to new sessions.
# agent:
#   api_max_retries: 3

# Recovery attempts: Times the agent tries to recover on its own after repeated failures.
# Applies to new sessions.
# agent:
#   auto_recovery_cycles: 5

# Startup wait: How long a first prompt waits for a new agent to finish loading.
# agent:
#   build_wait_timeout: 600

# Question timeout: How long the agent waits for your answer to a question.
# agent:
#   clarify_timeout: 3600

# Scheduled job wait: How long a restart waits for running scheduled jobs to finish.
# Restart the background service to apply.
# agent:
#   cron_drain_timeout: 30

# Resume window: How recent an interrupted chat app turn must be to resume itself.
# Restart the background service to apply.
# agent:
#   gateway_auto_continue_freshness: 3600

# Still-working notice: How often a chat app is told a long turn is still running.
# Zero turns the notices off.
# Restart the background service to apply.
# agent:
#   gateway_notify_interval: 180

# Startup restore wait: How long startup waits for interrupted turns to be restored.
# Restart the background service to apply.
# agent:
#   gateway_startup_restore_drain_timeout: 30

# Startup warmup wait: How long startup waits for the background service to warm up.
# Restart the background service to apply.
# agent:
#   gateway_startup_warmup_timeout: 20

# Chat turn timeout: How long a chat app turn may run before it is stopped.
# Restart the background service to apply.
# agent:
#   gateway_timeout: 1800

# Chat turn warning: How far into a chat turn a timeout warning is sent.
# Restart the background service to apply.
# agent:
#   gateway_timeout_warning: 900

# Turn lock timeout: How long a chat turn waits for the session to be free.
# Restart the background service to apply.
# agent:
#   gateway_turn_lease_timeout: 5

# Local silence limit: How long a local model may stay silent before the request is dropped.
# agent:
#   local_stream_stale_timeout: 900

# Reconnect alert delay: How long a chat app can stay disconnected before you are alerted.
# Zero or less turns the alert off.
# agent:
#   reconnect_attention_after: 7200

# Restart wait: How long a restart waits for running turns before going ahead.
# Restart the background service to apply.
# agent:
#   restart_after_turn_timeout: 1800

# Restart drain wait: How long shutdown waits for running work to wind down.
# Zero uses the built-in wait.
# Restart the background service to apply.
# agent:
#   restart_drain_timeout: 0

# Repair limit: Message repairs in a row before the agent reports a problem.
# agent:
#   sanitizer_heal_escalation_threshold: 3

# Stall timeout: How long a chat session may sit with no activity before it is stuck.
# Restart the background service to apply.
# agent:
#   session_stall_timeout: 300

# Stream close wait: How long to wait for a finished model stream to close.
# agent:
#   stream_drain_timeout: 2

# Stream time limit: Longest a single model response may keep streaming.
# Zero means no limit.
# agent:
#   stream_max_lifetime: 0

# Model silence limit: How long a model may stay silent before the request is retried.
# agent:
#   stream_stale_timeout: 180

# Hang check interval: How often a running turn is checked for being stuck.
# agent:
#   turn_liveness:
#     poll_s: 15

# Hang timeout: How long a turn can make no progress before it is flagged as stuck.
# Zero or less turns the check off.
# agent:
#   turn_liveness:
#     timeout_s: 600

# Memory trim cooldown: Minimum time between automatic memory cleanups.
# context:
#   memory_trim:
#     cooldown_seconds: 60

# Trim memory use: Give unused process memory back to the system after agents close.
# context:
#   memory_trim:
#     enabled: true

# Trim log threshold: Smallest memory cleanup, in MB, worth writing to the log.
# context:
#   memory_trim:
#     info_log_min_delta_mb: 0.0

# Trim log spacing: Log only every Nth memory cleanup.
# context:
#   memory_trim:
#     log_every_n: 1

# Database journal mode: How the session database writes to disk.
# Use delete on network drives or file systems that do not support write-ahead logs.
# One of: wal, delete.
# Restart the background service to apply.
# database:
#   journal_mode: wal

# Journal size cap: Largest size the database write log may keep after cleanup.
# Unset: database default.
# Restart the background service to apply.
# database:
#   journal_size_limit: null

# Checkpoint interval: Pages written before the database log is merged back.
# Unset: database default.
# Restart the background service to apply.
# database:
#   wal_autocheckpoint: null

# Database cache: Memory the session database keeps for recent pages.
# A positive number counts pages, a negative one counts KiB.
# Unset: database default.
# Restart the background service to apply.
# database:
#   cache_size: null

# Database memory map: How much of the session database is read through memory mapping.
# Unset: database default.
# Restart the background service to apply.
# database:
#   mmap_size: null

# Database temp storage: Where the session database keeps temporary tables.
# One of: 0, 1, 2.
# Unset: database default.
# Restart the background service to apply.
# database:
#   temp_store: null

# Database write safety: How carefully the session database waits for the disk after writes.
# macOS always keeps Full.
# One of: OFF, NORMAL, FULL, EXTRA.
# Unset: database default.
# Restart the background service to apply.
# database:
#   synchronous: null

# Live check timeout: How long each live connection check in the doctor may take.
# doctor:
#   live_probe_timeout: 10

# Local model engine: Which engine runs local models.
# Auto picks one for this machine.
# local_runtime:
#   backend: auto

# Local server ports: Ports checked for an already running local model server.
# local_runtime:
#   detect_ports: []

# Run local models: Start and manage a local model server automatically.
# local_runtime:
#   enabled: false

# Local models loaded: Most local models kept loaded at once.
# The real limit can be lower when the graphics card cannot fit this many.
# local_runtime:
#   models_max: 4

# Local server port: Port the local model server listens on.
# Zero lets the system choose a free port.
# local_runtime:
#   port: 0

# Old logs kept: How many rotated copies of each log file are kept.
# Restart the background service to apply.
# logging:
#   backup_count: 3

# Log detail: How much the log files record.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Restart the background service to apply.
# logging:
#   level: INFO

# Log file size: Size at which a log file is rotated.
# Restart the background service to apply.
# logging:
#   max_size_mb: 5

# Retry failed servers: How long to wait before retrying a code server that failed.
# Zero never retries until restart.
# lsp:
#   broken_retry_seconds: 0

# Code checking: Check edited files for problems using language servers.
# lsp:
#   enabled: true

# Skip folders: Folders, as glob patterns, where code checking is never used.
# lsp:
#   exclude_roots: []

# Server idle time: How long an unused language server runs before it is stopped.
# lsp:
#   idle_timeout: 600

# Install language servers: Whether missing language servers are installed for you.
# One of: auto, manual.
# lsp:
#   install_strategy: auto

# Node package manager: Tool used to install language servers written for Node.
# One of: npm, pnpm, yarn.
# lsp:
#   package_manager: npm

# Language servers: Per-server overrides such as custom commands or disabling one.
# lsp:
#   servers: {}

# Trusted folders: Extra folders where project-defined checkers may run.
# lsp:
#   trusted_workspaces: []

# Check wait mode: How much to wait for after an edit before reporting problems.
# One of: document, full.
# lsp:
#   wait_mode: document

# Check wait time: Longest wait for code problems after an edit.
# lsp:
#   wait_timeout: 5

# Code server warmup: Extra time a new language server gets to start before checks.
# Zero means no extra wait.
# lsp:
#   warmup_timeout: 0

# Active session limit: Most chat sessions that may run a turn at once.
# Unset: no limit.
# Restart the background service to apply.
# max_concurrent_sessions: null

# Live session limit: Most sessions kept open before the least recent are closed.
# Zero removes the limit.
# max_live_sessions: 16

# Online model list: Fetch the list of available models from the online catalog.
# model_catalog:
#   enabled: true

# Hidden providers: Providers left out of the model picker.
# model_catalog:
#   excluded_providers: []

# Provider overrides: Per-provider changes applied to the online model list.
# model_catalog:
#   providers: {}

# Model list refresh: How often the online model list is refreshed.
# model_catalog:
#   ttl_minutes: 20

# Model list address: Web address the online model list is fetched from.
# model_catalog:
#   url: https://icebath.app/api/model-catalog.json

# Model details address: Web address for model details such as limits and prices.
# Empty uses the public models.dev registry.
# models_dev:
#   url: ''

# Send telemetry: Send traces to an OpenTelemetry collector.
# Needs an address under the collector endpoint setting.
# monitoring:
#   export:
#     otlp:
#       enabled: false

# Collector address: Web address of the OpenTelemetry collector.
# monitoring:
#   export:
#     otlp:
#       endpoint: ''

# Collector headers: Request headers for the collector, each read from a named variable.
# monitoring:
#   export:
#     otlp:
#       headers_env: {}

# Send diagnostic events: Include diagnostic events in the background service health export.
# monitoring:
#   gateway_health_export:
#     diagnostic_events_enabled: true

# Export service health: Send background service health data to the telemetry collector.
# monitoring:
#   gateway_health_export:
#     enabled: false

# Metrics interval: How often health metrics are sent.
# monitoring:
#   gateway_health_export:
#     export_interval_seconds: 60

# Log export interval: How often warning and error logs are sent.
# monitoring:
#   gateway_health_export:
#     logs_export_interval_seconds: 5

# Send health metrics: Include numeric health metrics in the export.
# monitoring:
#   gateway_health_export:
#     metrics_enabled: true

# Export labels: Labels such as an environment name attached to exported health data.
# Only service, cloud and environment names are sent; the service name is always icebath.
# monitoring:
#   gateway_health_export:
#     resource_attributes: {}

# Send warning logs: Include warning and error log events in the export.
# monitoring:
#   gateway_health_export:
#     warning_error_events_enabled: true

# Install ID: Anonymous ID that labels this install in exported data.
# Created automatically when empty.
# monitoring:
#   install_id: ''

# Prefer IPv4: Try IPv4 addresses first, for networks with broken IPv6.
# Restart the background service to apply.
# network:
#   force_ipv4: false

# Profile setup offer: Whether the agent offers to build your profile.
# One of: ask, off.
# onboarding:
#   profile_build: ask

# Seen tips: Which first-run tips you have already seen.
# Filled in automatically.
# onboarding:
#   seen: {}

# Memory arenas: Cap on memory pools the system allocator creates.
# Lower values reduce memory growth on Linux.
# Restart the background service to apply.
# runtime:
#   malloc_arena_max: 4

# Open file limit: Open files the background service asks the system to allow.
# Restart the background service to apply.
# runtime:
#   nofile_soft_limit: 4096

# Switch on update: Return to the update branch when updating from another one.
# updates:
#   auto_switch_parked_branch: true

# Backups kept: How many full pre-update backups are kept.
# updates:
#   backup_keep: 5

# Check for updates: Look for new versions in the background.
# updates:
#   check: true

# Unattended local edits: What an unattended update does with your changes to the source.
# One of: stash, discard.
# updates:
#   non_interactive_local_changes: stash

# Other-branch update: What an update does when a non-default branch is checked out.
# One of: switch, update_in_place.
# updates:
#   parked_branch_strategy: switch

# Backup before update: What is backed up before an update runs.
# One of: off, quick, full.
# updates:
#   pre_update_backup: quick

# Refresh computer driver: Update the computer-control helper along with the app.
# updates:
#   refresh_cua_driver: true

# Tool batch limit: Longest a batch of tool calls run at the same time may take.
# Zero means no limit.
# Applies from the next turn.
# timeouts:
#   tools:
#     concurrent_batch: 420

# Single tool limit: Longest one tool call run on its own may take.
# Zero means no limit.
# Unset: the tool batch limit.
# Applies from the next turn.
# timeouts:
#   tools:
#     sequential_call: null

# Request time limit: How long one model request may take before it is given up.
# A provider's own request timeout under Providers wins over this.
# Applies from the next turn.
# agent:
#   api_timeout: 1800

# Silent request limit: How long a model may stay silent on a request that is not streamed.
# Unset picks it from the model and the request size. A provider's own stale timeout wins over this.
# Unset: picked from the model and request size.
# Applies from the next turn.
# agent:
#   api_call_stale_timeout: null
