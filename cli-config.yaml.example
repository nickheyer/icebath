# Title key: API key for session titles.
# Empty uses your normal login.
# Kept in .env, never in config.yaml.

# Title URL: Custom endpoint address for session titles.
# auxiliary:
#   title_generation:
#     base_url: ''

# Auto titles: Name new sessions automatically.
# auxiliary:
#   title_generation:
#     enabled: true

# Title fields: Extra request fields for session titles.
# auxiliary:
#   title_generation:
#     extra_body: {}

# Title language: Language of session titles.
# Empty matches the language of your message.
# auxiliary:
#   title_generation:
#     language: ''

# Title model: Model for session titles.
# Empty picks one for you.
# auxiliary:
#   title_generation:
#     model: ''

# Better titles: Replace the quick title with one written by the title model.
# auxiliary:
#   title_generation:
#     model_upgrade_enabled: true

# Prefer fast model: Pick a quicker model for titles when one is available.
# auxiliary:
#   title_generation:
#     prefer_fast_model: false

# Title provider: Provider for session titles.
# Auto picks one for you.
# auxiliary:
#   title_generation:
#     provider: auto

# Title thinking: Thinking effort for session titles.
# One of: none, minimal, low, medium, high, xhigh, max, ultra.
# Unset: the model's default.
# auxiliary:
#   title_generation:
#     reasoning_effort: null

# Title timeout: Time limit for session titles.
# auxiliary:
#   title_generation:
#     timeout: 30

# Helper retries: Retries for helper calls after a brief network error.
# Between 0 and 6.
# auxiliary:
#   transient_retries: 2

