{
  "name": "icebath",
  "displayName": "icebath",
  "description": "The file changes of the icebath TUI as diffs in the editor, with the session and mode in the status bar",
  "version": "0.1.1",
  "publisher": "HeyerApp",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://icebath.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickheyer/icebath"
  },
  "bugs": {
    "url": "https://github.com/nickheyer/icebath/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "icebath",
    "agent",
    "acp",
    "terminal",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "icebath.open",
        "title": "icebath: open"
      },
      {
        "command": "icebath.prompt",
        "title": "icebath: prompt"
      },
      {
        "command": "icebath.cancel",
        "title": "icebath: cancel run"
      },
      {
        "command": "icebath.sessions",
        "title": "icebath: sessions"
      },
      {
        "command": "icebath.mode",
        "title": "icebath: mode"
      },
      {
        "command": "icebath.showLog",
        "title": "icebath: show log"
      },
      {
        "command": "icebath.install",
        "title": "icebath: install binary"
      },
      {
        "command": "icebath.revert",
        "title": "Revert",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "icebath.revert",
          "group": "navigation@1",
          "when": "resourceScheme == icebath-after && icebath.revertable"
        }
      ],
      "commandPalette": [
        {
          "command": "icebath.revert",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "icebath",
      "properties": {
        "icebath.path": {
          "type": "string",
          "default": "",
          "description": "Path of the icebath binary, icebath on PATH when empty"
        },
        "icebath.editorContext": {
          "type": "boolean",
          "default": false,
          "description": "Send the active file path and selection with prompts submitted from VS Code"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "package": "npm run build && vsce package --no-dependencies --out icebath.vsix",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
