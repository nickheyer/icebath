{
  "name": "@icebath/bootstrap-installer",
  "private": true,
  "version": "0.0.0",
  "description": "Icebath Setup — signed installer with a polished native UI over the Go install core.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --minify false --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "check": "npm run typecheck && npm run lint",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "fix": "npm run lint:fix"
  },
  "dependencies": {
    "@nous-research/ui": "0.19.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@vscode/codicons": "0.0.45",
    "@wailsio/runtime": "3.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.19.0",
    "lucide-react": "0.577.0",
    "nanostores": "1.4.2",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-shimmer": "0.4.13"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
